   "reply": "\n\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"def _parse(v):\\n    \\\"\\\"\\\"Parse a SemVer 2.0.0 string into a sortable key.\\\"\\\"\\\"\\n    # Split off build metadata first; it is ignored for precedence.\\n    core_and_pre = v.split('+', 1)[0]\\n\\n    if '-' in core_and_pre:\\n        core, pre = core_and_pre.split('-', 1)\\n    else:\\n        core, pre = core_and_pre, None\\n\\n    major_s, minor_s, patch_s = core.split('.')\\n    major, minor, patch = int(major_s), int(minor_s), int(patch_s)\\n\\n    if pre is None:\\n        # A version without a pre-release has higher precedence than one\\n        # with a pre-release, all other parts being equal.\\n        pre_key = (1,)\\n    else:\\n        identifiers = []\\n        for part in pre.split('.'):\\n            if part.isdigit():\\n                identifiers.append((0, int(part)))\\n            else:\\n                identifiers.append((1, part))\\n        pre_key = (0, tuple(identifiers))\\n\\n    return (major, minor, patch, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return semantic version strings sorted by SemVer precedence.\\n\\n    Build metadata is ignored for ordering. Equal versions retain their\\n    original relative order (Python's sort is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_parse)\\n\"}",
