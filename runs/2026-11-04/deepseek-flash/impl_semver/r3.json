   "reply": "{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Semantic version sorting utilities.\\\"\\\"\\\"\\n\\n\\ndef _parse_version(version):\\n    \\\"\\\"\\\"Return a sortable key for a SemVer 2.0.0 version string.\\\"\\\"\\\"\\n    # Build metadata is ignored for precedence.\\n    without_build = version.split('+', 1)[0]\\n\\n    if '-' in without_build:\\n        core, prerelease = without_build.split('-', 1)\\n        prerelease_ids = prerelease.split('.')\\n    else:\\n        core = without_build\\n        prerelease_ids = None\\n\\n    major, minor, patch = (int(part) for part in core.split('.'))\\n\\n    if prerelease_ids is None:\\n        # A final release has higher precedence than any prerelease.\\n        pre_key = (1,)\\n    else:\\n        identifiers = []\\n        for identifier in prerelease_ids:\\n            if identifier.isdigit():\\n                identifiers.append((0, int(identifier)))\\n            else:\\n                identifiers.append((1, identifier))\\n        pre_key = (0, tuple(identifiers))\\n\\n    return (major, minor, patch, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Sort semantic version strings by SemVer precedence, lowest first.\\n\\n    Build metadata is ignored, and versions with equal precedence retain their\\n    original input order.\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_parse_version)\\n\"}",
