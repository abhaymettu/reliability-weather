   "reply": "{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"SemVer 2.0.0 sorting support.\\\"\\\"\\\"\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return `vs` sorted by SemVer 2.0.0 precedence, lowest first.\\n\\n    Build metadata is ignored for ordering.  Equal precedence preserves the\\n    original input order (Python's sort is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_sort_key)\\n\\n\\ndef _sort_key(version):\\n    base = version.split('+', 1)[0]  # discard build metadata\\n\\n    if '-' in base:\\n        core, prerelease = base.split('-', 1)\\n        prerelease_identifiers = prerelease.split('.')\\n        prerelease_key = (0, tuple(_identifier_key(i) for i in prerelease_identifiers))\\n    else:\\n        core = base\\n        prerelease_key = (1, ())  # a release is higher than any pre-release\\n\\n    major, minor, patch = core.split('.')\\n    return (int(major), int(minor), int(patch), prerelease_key)\\n\\n\\ndef _identifier_key(identifier):\\n    if identifier.isdigit():\\n        # Numeric identifiers compare as integers and sort before non-numeric.\\n        return (0, int(identifier), '')\\n    # Non-numeric identifiers compare lexically in ASCII order.\\n    return (1, 0, identifier)\\n\"}",
