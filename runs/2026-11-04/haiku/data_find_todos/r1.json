   "reply": "{\"action\": \"write\", \"path\": \"_find_todos.py\", \"content\": \"import os\\nimport tokenize\\n\\nresults = []\\nfor root, dirs, files in os.walk('.'):\\n    dirs[:] = [d for d in dirs if d != '.git']\\n    for name in files:\\n        if not name.endswith('.py'):\\n            continue\\n        full = os.path.join(root, name)\\n        rel = os.path.relpath(full, '.').replace(os.sep, '/')\\n        try:\\n            with open(full, 'rb') as fh:\\n                toks = list(tokenize.tokenize(fh.readline))\\n        except (tokenize.TokenError, SyntaxError, OSError) as e:\\n            print('skip', rel, e)\\n            continue\\n        for tok in toks:\\n            if tok.type == tokenize.COMMENT and 'TODO' in tok.string:\\n                results.append((rel, tok.start[0]))\\n\\nresults = sorted(set(results))\\nwith open('todos.txt', 'w') as out:\\n    for rel, line in results:\\n        out.write(f'{rel}:{line}\\\\n')\\nprint(len(results), 'occurrences written')\\n\"}",
