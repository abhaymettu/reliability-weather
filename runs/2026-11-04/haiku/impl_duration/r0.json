   "reply": "\n<invoke_placeholder>\n{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"_UNITS = {\\\"d\\\": 86400, \\\"h\\\": 3600, \\\"m\\\": 60, \\\"s\\\": 1}\\n_ORDER = \\\"dhms\\\"\\n_DIGITS = \\\"0123456789\\\"\\n\\n\\ndef parse_duration(s):\\n    \\\"\\\"\\\"Convert a duration string such as '1d2h', '1h30m' or '45s' to seconds.\\n\\n    Units are d, h, m, s; each appears at most once, in that order. Amounts are\\n    non-negative integers. Surrounding whitespace is allowed. Anything else,\\n    including an empty string or a bare number, raises ValueError.\\n    \\\"\\\"\\\"\\n    if not isinstance(s, str):\\n        raise ValueError(f\\\"duration must be a string, not {type(s).__name__}\\\")\\n\\n    text = s.strip()\\n    if not text:\\n        raise ValueError(\\\"empty duration\\\")\\n\\n    n = len(text)\\n    i = 0\\n    last = -1\\n    total = 0\\n    while i < n:\\n        start = i\\n        while i < n and text[i] in _DIGITS:\\n            i += 1\\n        if i == start:\\n            raise ValueError(f\\\"expected an amount at position {start} in {s!r}\\\")\\n        if i >= n:\\n            raise ValueError(f\\\"missing unit after amount in {s!r}\\\")\\n        unit = text[i]\\n        if unit not in _UNITS:\\n            raise ValueError(f\\\"unknown unit {unit!r} in {s!r}\\\")\\n        idx = _ORDER.index(unit)\\n        if idx <= last:\\n            raise ValueError(f\\\"unit {unit!r} repeated or out of order in {s!r}\\\")\\n        last = idx\\n        total += int(text[start:i]) * _UNITS[unit]\\n        i += 1\\n\\n    return total\\n\"}",
