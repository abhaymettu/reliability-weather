   "turn": 1,
   "reply": "\n<invoke:write>\n{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"import re\\n\\n_PATTERN = re.compile(\\n    r\\\"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?\\\"\\n)\\n_MULTIPLIERS = (86400, 3600, 60, 1)\\n\\n\\ndef parse_duration(s):\\n    \\\"\\\"\\\"Convert a duration string such as '1h30m' or '1d2h' to whole seconds.\\n\\n    Units are d (days), h (hours), m (minutes) and s (seconds). Each unit may\\n    appear at most once, in that order, with a non-negative integer amount.\\n    Surrounding whitespace is ignored. Raises ValueError for anything else.\\n    \\\"\\\"\\\"\\n    if not isinstance(s, str):\\n        raise ValueError(f\\\"expected a string, got {type(s).__name__}\\\")\\n\\n    text = s.strip()\\n    match = _PATTERN.fullmatch(text)\\n    if not match or not text:\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    groups = match.groups()\\n    if all(g is None for g in groups):\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    return sum(int(g) * m for g, m in zip(groups, _MULTIPLIERS) if g is not None)\\n\"}\n{\"action\": \"finish\"}",
