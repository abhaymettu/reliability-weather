   "reply": "\n{\"action\": \"write\", \"path\": \"luhn.py\", \"content\": \"\\\"\\\"\\\"Validate card numbers with the Luhn algorithm.\\\"\\\"\\\"\\n\\n_DIGITS = \\\"0123456789\\\"\\n\\n\\ndef valid(number):\\n    \\\"\\\"\\\"Return True if `number` passes the Luhn check, else False.\\n\\n    Spaces are removed before checking. The result is False if fewer than\\n    two characters remain or if any remaining character is not a digit 0-9.\\n    \\\"\\\"\\\"\\n    digits = number.replace(\\\" \\\", \\\"\\\")\\n\\n    if len(digits) < 2:\\n        return False\\n    if any(c not in _DIGITS for c in digits):\\n        return False\\n\\n    total = 0\\n    # Walk from the rightmost digit; double every second digit.\\n    for i, c in enumerate(reversed(digits)):\\n        d = int(c)\\n        if i % 2 == 1:\\n            d *= 2\\n            if d > 9:\\n                d -= 9\\n        total += d\\n\\n    return total % 10 == 0\\n\"}",
