   "reply": "\n<invoke/write>\n{\"action\": \"write\", \"path\": \"luhn.py\", \"content\": \"\\\"\\\"\\\"Validate card numbers using the Luhn algorithm.\\\"\\\"\\\"\\n\\n\\ndef valid(number):\\n    \\\"\\\"\\\"Return True if the card number passes the Luhn check.\\n\\n    The input is a string. Spaces are removed before checking. The result is\\n    False if fewer than two characters remain or if any remaining character\\n    is not a digit from 0 to 9.\\n    \\\"\\\"\\\"\\n    digits = number.replace(\\\" \\\", \\\"\\\")\\n\\n    if len(digits) < 2:\\n        return False\\n\\n    for ch in digits:\\n        if ch not in \\\"0123456789\\\":\\n            return False\\n\\n    total = 0\\n    # Walk from the rightmost digit to the leftmost.\\n    for index, ch in enumerate(reversed(digits)):\\n        d = int(ch)\\n        if index % 2 == 1:\\n            d *= 2\\n            if d > 9:\\n                d -= 9\\n        total += d\\n\\n    return total % 10 == 0\\n\"}\n{\"action\": \"finish\"}",
