   "reply": "\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _parse(version):\\n    \\\"\\\"\\\"Return a sort key for a SemVer string. Build metadata is ignored.\\\"\\\"\\\"\\n    # Build metadata (after '+') does not affect precedence.\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n\\n    # Pre-release starts at the first hyphen; the core has no hyphens.\\n    core, _, pre = core_and_pre.partition(\\\"-\\\")\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n    core_key = (major, minor, patch)\\n\\n    if not pre:\\n        # A release version is higher than any pre-release of the same core.\\n        return core_key + ((1,),)\\n\\n    pre_key = []\\n    for ident in pre.split(\\\".\\\"):\\n        if ident.isdigit():\\n            # Numeric identifiers: compare as integers, lower than alphanumeric.\\n            pre_key.append((0, int(ident), \\\"\\\"))\\n        else:\\n            # Alphanumeric identifiers: compare in ASCII order.\\n            pre_key.append((1, 0, ident))\\n\\n    # Tuple comparison makes a shorter list lower when the shared prefix is equal.\\n    return core_key + ((0, tuple(pre_key)),)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the versions sorted lowest precedence first.\\n\\n    Versions that compare equal keep their input order (sorted is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_parse)\\n\"}",
