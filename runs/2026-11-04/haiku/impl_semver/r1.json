   "turn": 1,
   "reply": "{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _identifier_key(ident):\\n    # Numeric identifiers sort before alphanumeric ones; numeric compare as ints,\\n    # alphanumeric compare in ASCII order. Tuples keep the two kinds comparable.\\n    if ident.isdigit():\\n        return (0, int(ident), \\\"\\\")\\n    return (1, 0, ident)\\n\\n\\ndef _precedence_key(version):\\n    # Build metadata (after '+') is ignored for precedence.\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n\\n    # Pre-release begins at the first hyphen; later hyphens belong to the identifiers.\\n    if \\\"-\\\" in core_and_pre:\\n        core, pre = core_and_pre.split(\\\"-\\\", 1)\\n    else:\\n        core, pre = core_and_pre, None\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    if pre is None:\\n        # A release sorts above any pre-release of the same core version.\\n        return (major, minor, patch, 1, ())\\n\\n    identifiers = tuple(_identifier_key(part) for part in pre.split(\\\".\\\"))\\n    # Python tuple comparison gives the shorter-list-is-lower rule for free.\\n    return (major, minor, patch, 0, identifiers)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the version strings in vs sorted lowest precedence first.\\n\\n    Versions with equal precedence keep their input order (sorted is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_precedence_key)\\n\"}",
