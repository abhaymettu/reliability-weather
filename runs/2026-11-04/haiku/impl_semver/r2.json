   "turn": 1,
   "reply": "{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\n_DIGITS = frozenset('0123456789')\\n\\n\\ndef _identifier_key(ident):\\n    \\\"\\\"\\\"Numeric identifiers compare as integers and sort below alphanumeric ones.\\\"\\\"\\\"\\n    if ident and all(c in _DIGITS for c in ident):\\n        return (0, int(ident), '')\\n    return (1, 0, ident)\\n\\n\\ndef _precedence_key(version):\\n    \\\"\\\"\\\"Return a sort key implementing SemVer 2.0.0 precedence.\\n\\n    Build metadata (after '+') is ignored.\\n    \\\"\\\"\\\"\\n    core = version.split('+', 1)[0]\\n    if '-' in core:\\n        core, pre = core.split('-', 1)\\n        pre_key = (0, tuple(_identifier_key(i) for i in pre.split('.')))\\n    else:\\n        # A release sorts above any pre-release of the same numeric version.\\n        pre_key = (1, ())\\n    numbers = tuple(int(part) for part in core.split('.'))\\n    return (numbers, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the version strings in vs sorted lowest precedence first.\\n\\n    Versions with equal precedence keep their input order (sort is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_precedence_key)\\n\"}",
