   "turn": 1,
   "reply": "{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _split(version):\\n    \\\"\\\"\\\"Return (core, prerelease) with build metadata discarded.\\n\\n    The build metadata is removed first, because it may contain hyphens.\\n    The core (MAJOR.MINOR.PATCH) never contains a hyphen, so splitting on the\\n    first hyphen separates the pre-release correctly.\\n    \\\"\\\"\\\"\\n    base = version.split('+', 1)[0]\\n    if '-' in base:\\n        core, pre = base.split('-', 1)\\n        return core, pre\\n    return base, None\\n\\n\\ndef _ident_key(identifier):\\n    \\\"\\\"\\\"Key for one pre-release identifier.\\n\\n    Numeric identifiers compare as integers and sort below alphanumeric ones.\\n    Alphanumeric identifiers compare in ASCII order.\\n    \\\"\\\"\\\"\\n    if identifier.isdigit():\\n        return (0, int(identifier), '')\\n    return (1, 0, identifier)\\n\\n\\ndef _version_key(version):\\n    core, pre = _split(version)\\n    major, minor, patch = (int(part) for part in core.split('.'))\\n    if pre is None:\\n        # A release version sorts above any pre-release of the same core.\\n        pre_key = (1, ())\\n    else:\\n        # Tuple comparison makes a shorter list lower when the shared\\n        # identifiers are equal.\\n        pre_key = (0, tuple(_ident_key(p) for p in pre.split('.')))\\n    return (major, minor, patch, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the versions sorted lowest precedence first.\\n\\n    Ties keep their input order because Python's sort is stable.\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_version_key)\\n\"}",
