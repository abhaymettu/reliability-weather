   "turn": 1,
   "reply": "{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"import re\\n\\n_IDENT = r\\\"[0-9A-Za-z-]+\\\"\\n_VERSION_RE = re.compile(\\n    r\\\"^([0-9]+)\\\\.([0-9]+)\\\\.([0-9]+)\\\"\\n    r\\\"(?:-(\\\" + _IDENT + r\\\"(?:\\\\.\\\" + _IDENT + r\\\")*))?\\\"\\n    r\\\"(?:\\\\+(\\\" + _IDENT + r\\\"(?:\\\\.\\\" + _IDENT + r\\\")*))?$\\\"\\n)\\n\\n\\ndef _precedence_key(version):\\n    \\\"\\\"\\\"Return a sort key implementing SemVer 2.0.0 precedence.\\n\\n    Build metadata is ignored.\\n    \\\"\\\"\\\"\\n    m = _VERSION_RE.match(version)\\n    if m is None:\\n        raise ValueError(f\\\"invalid semantic version: {version!r}\\\")\\n    major, minor, patch = int(m.group(1)), int(m.group(2)), int(m.group(3))\\n    pre = m.group(4)\\n    if pre is None:\\n        # A release version has higher precedence than any pre-release.\\n        pre_key = (1, ())\\n    else:\\n        ids = []\\n        for part in pre.split(\\\".\\\"):\\n            if all(c in \\\"0123456789\\\" for c in part):\\n                # Numeric identifiers: compare as integers, lower than alphanumeric.\\n                ids.append((0, int(part), \\\"\\\"))\\n            else:\\n                # Alphanumeric identifiers: compare in ASCII order.\\n                ids.append((1, 0, part))\\n        # Tuples compare element-wise, so a shorter list that is a prefix is lower.\\n        pre_key = (0, tuple(ids))\\n    return (major, minor, patch, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the semantic version strings in vs sorted lowest precedence first.\\n\\n    Versions that compare equal keep their input order (sorted is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_precedence_key)\\n\"}",
