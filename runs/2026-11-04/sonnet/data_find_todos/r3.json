   "turn": 1,
   "reply": "\n<invoke name=\"write\">\n<parameter name=\"path\">_scan.py</parameter>\n<parameter name=\"content\">import os, tokenize\nK = 'TO' + 'DO'\nres = []\nfor d, ds, fs in os.walk('.'):\n    for f in fs:\n        if not f.endswith('.py'):\n            continue\n        p = os.path.join(d, f)\n        rel = os.path.relpath(p, '.').replace(os.sep, '/')\n        last = 0\n        try:\n            with open(p, 'rb') as fh:\n                for t in tokenize.tokenize(fh.readline):\n                    last = t.start[0]\n                    if t.type == tokenize.COMMENT and K in t.string:\n                        res.append((rel, t.start[0]))\n        except Exception:\n            with open(p, encoding='utf-8', errors='replace') as fh:\n                for i, line in enumerate(fh, 1):\n                    if i > last and '#' in line and K in line[line.index('#'):]:\n                        res.append((rel, i))\nres = sorted(set(res))\nwith open('todos.txt', 'w') as o:\n    for r, l in res:\n        o.write('%s:%d\\n' % (r, l))\nprint(res)\n</parameter>\n</invoke>\neaders",
