   "reply": "{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"import functools\\n\\n\\ndef _parse(v):\\n    v = v.strip().split('+', 1)[0]\\n    if '-' in v:\\n        core, pre = v.split('-', 1)\\n        pre = pre.split('.')\\n    else:\\n        core, pre = v, None\\n    nums = tuple(int(x) for x in core.split('.'))\\n    return nums, pre\\n\\n\\ndef _cmp_id(a, b):\\n    an, bn = a.isdigit(), b.isdigit()\\n    if an and bn:\\n        a, b = int(a), int(b)\\n        return (a > b) - (a < b)\\n    if an:\\n        return -1\\n    if bn:\\n        return 1\\n    return (a > b) - (a < b)\\n\\n\\ndef _cmp(x, y):\\n    (n1, p1), (n2, p2) = x, y\\n    if n1 != n2:\\n        return -1 if n1 < n2 else 1\\n    if p1 is None and p2 is None:\\n        return 0\\n    if p1 is None:\\n        return 1\\n    if p2 is None:\\n        return -1\\n    for a, b in zip(p1, p2):\\n        c = _cmp_id(a, b)\\n        if c:\\n            return c\\n    return (len(p1) > len(p2)) - (len(p1) < len(p2))\\n\\n\\ndef sort_versions(vs):\\n    parsed = [(_parse(v), v) for v in vs]\\n    parsed.sort(key=functools.cmp_to_key(lambda a, b: _cmp(a[0], b[0])))\\n    return [v for _, v in parsed]\\n\"}",
