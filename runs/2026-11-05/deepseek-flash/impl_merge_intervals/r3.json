   "reply": "{\"action\": \"write\", \"path\": \"intervals.py\", \"content\": \"def merge(intervals):\\n    \\\"\\\"\\\"Merge overlapping or touching [start, end] intervals.\\n\\n    Returns a new list of disjoint intervals sorted by start.\\n    The input list and its intervals are not modified.\\n    \\\"\\\"\\\"\\n    if not intervals:\\n        return []\\n\\n    ordered = sorted((list(interval) for interval in intervals),\\n                     key=lambda iv: (iv[0], iv[1]))\\n\\n    merged = [ordered[0]]\\n    for start, end in ordered[1:]:\\n        last_start, last_end = merged[-1]\\n        if start <= last_end:\\n            if end > last_end:\\n                merged[-1] = [last_start, end]\\n        else:\\n            merged.append([start, end])\\n\\n    return merged\\n\"}\n\n{\"action\": \"run\", \"args\": [\"-c\", \"from intervals import merge; cases=[([[1,3],[3,5]],[[1,5]]),([],[]),([[5,7],[1,2]],[ [1,2],[5,7]]),([[1,10],[2,3],[4,5]],[[1,10]]),([[1,2],[3,4]],[[1,2],[3,4]]),([[1,4],[2,3]],[ [1,4]]),([[0,0],[0,0]],[ [0,0]]),([[1,2],[2,2],[3,4]],[ [1,4]])];\\nfor inp,exp in cases:\\n    orig=[list(x) for x in inp]; r=merge(inp); assert r==exp,(inp,r,exp); assert inp==orig,(inp,orig)\\nprint('ok')\"]}",
