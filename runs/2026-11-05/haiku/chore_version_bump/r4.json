   "reply": "{\"action\": \"write\", \"path\": \".release_bump.py\", \"content\": \"import re, sys\\nNEW = '1.5.0'\\nDATE = '2026-11-04'\\ndef rd(p):\\n    with open(p, encoding='utf-8') as f:\\n        return f.read()\\nt = rd('pyproject.toml')\\nm = re.search(r'^version\\\\s*=\\\\s*\\\\x22([^\\\\x22]+)\\\\x22', t, re.M)\\nif not m:\\n    sys.exit('no version in pyproject.toml')\\nold = m.group(1)\\nif old == NEW:\\n    sys.exit('already at 1.5.0')\\nprint('old version:', old)\\npyproj = t[:m.start(1)] + NEW + t[m.end(1):]\\nip = 'src/fmt/__init__.py'\\nt = rd(ip)\\nm = re.search(r'(__version__\\\\s*=\\\\s*[\\\\x22\\\\x27])([^\\\\x22\\\\x27]+)([\\\\x22\\\\x27])', t)\\nif not m or m.group(2) != old:\\n    sys.exit('__init__ version mismatch')\\ninit_new = t[:m.start(2)] + NEW + t[m.end(2):]\\nt = rd('README.md')\\npat = r'(?<![\\\\w.])' + re.escape(old) + r'(?![\\\\w.])'\\nreadme_new, n = re.subn(pat, NEW, t)\\nif n == 0:\\n    sys.exit('no version in README.md')\\nfor line in t.splitlines():\\n    if re.search(pat, line):\\n        print('README:', line)\\nlines = rd('CHANGELOG.md').splitlines(keepends=True)\\nidx = None\\nfor i, l in enumerate(lines):\\n    if re.match(r'^#+\\\\s.*\\\\d+\\\\.\\\\d+\\\\.\\\\d+', l):\\n        idx = i\\n        break\\nif idx is None:\\n    sys.exit('no changelog heading')\\nnewh = lines[idx].rstrip('\\\\n').replace(old, NEW)\\nnewh = re.sub(r'\\\\d{4}-\\\\d{2}-\\\\d{2}', DATE, newh)\\nlines[idx:idx] = [newh + '\\\\n', '\\\\n', '- Add the --json flag.\\\\n', '\\\\n']\\nopen('pyproject.toml', 'w', encoding='utf-8').write(pyproj)\\nopen(ip, 'w', encoding='utf-8').write(init_new)\\nopen('README.md', 'w', encoding='utf-8').write(readme_new)\\nopen('CHANGELOG.md', 'w', encoding='utf-8').write(''.join(lines))\\nprint('CHANGELOG top:')\\nprint(''.join(lines[:idx + 6]))\\n\"}",
