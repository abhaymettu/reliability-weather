   "turn": 1,
   "reply": "\n{\"action\": \"write\", \"path\": \"/tmp/find_todos/find_todos.py\", \"content\": \"import os\\nimport sys\\nimport tokenize\\nimport io\\n\\nroot = '.'\\nresults = set()\\n\\nfor dp, dns, fns in os.walk(root):\\n    dns[:] = [d for d in dns if d != '.git']\\n    for fn in fns:\\n        if not fn.endswith('.py'):\\n            continue\\n        full = os.path.join(dp, fn)\\n        rel = os.path.relpath(full, root).replace(os.sep, '/')\\n        try:\\n            with open(full, 'rb') as f:\\n                data = f.read()\\n            for t in tokenize.tokenize(io.BytesIO(data).readline):\\n                if t.type == tokenize.COMMENT and 'TODO' in t.string:\\n                    results.add((rel, t.start[0]))\\n        except Exception as e:\\n            sys.stderr.write('skip %s: %s\\\\n' % (rel, e))\\n\\nwith open('todos.txt', 'w') as f:\\n    for rel, ln in sorted(results):\\n        f.write('%s:%d\\\\n' % (rel, ln))\\n\\nprint(len(results))\\n\"}",
