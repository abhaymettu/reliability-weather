   "reply": "\n<invoke_action_placeholder_do_not_use>\n{\"action\": \"write\", \"path\": \"find_todos.py\", \"content\": \"import os\\nimport sys\\nimport tokenize\\n\\nresults = []\\nfor root, dirs, files in os.walk('.'):\\n    dirs[:] = [d for d in dirs if d != '.git']\\n    for f in files:\\n        if not f.endswith('.py'):\\n            continue\\n        full = os.path.join(root, f)\\n        rel = os.path.relpath(full, '.').replace(os.sep, '/')\\n        try:\\n            with tokenize.open(full) as fh:\\n                for tok in tokenize.generate_tokens(fh.readline):\\n                    if tok.type == tokenize.COMMENT and 'TODO' in tok.string:\\n                        results.append((rel, tok.start[0]))\\n        except (SyntaxError, tokenize.TokenError, UnicodeDecodeError, OSError) as e:\\n            print('skipped', rel, e, file=sys.stderr)\\n\\nresults = sorted(set(results))\\nwith open('todos.txt', 'w', encoding='utf-8') as out:\\n    for p, l in results:\\n        out.write(f'{p}:{l}\\\\n')\\n\"}",
