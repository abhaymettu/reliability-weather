   "turn": 1,
   "reply": "\n<invoke_action>\n{\"action\": \"write\", \"path\": \"/tmp/find_todos.py\", \"content\": \"import os\\nimport sys\\nimport tokenize\\n\\nroot = os.path.abspath(sys.argv[1])\\nresults = []\\n\\nfor dirpath, dirnames, filenames in os.walk(root):\\n    dirnames[:] = [d for d in dirnames if d != '.git']\\n    for fn in filenames:\\n        if not fn.endswith('.py'):\\n            continue\\n        full = os.path.join(dirpath, fn)\\n        rel = os.path.relpath(full, root).replace(os.sep, '/')\\n        try:\\n            with tokenize.open(full) as f:\\n                toks = list(tokenize.generate_tokens(f.readline))\\n        except (tokenize.TokenError, SyntaxError, OSError, UnicodeDecodeError) as e:\\n            sys.stderr.write('skip %s: %s\\\\n' % (rel, e))\\n            continue\\n        for t in toks:\\n            if t.type == tokenize.COMMENT and 'TODO' in t.string:\\n                results.append((rel, t.start[0]))\\n\\nresults.sort()\\nwith open(os.path.join(root, 'todos.txt'), 'w') as out:\\n    for rel, line in results:\\n        out.write('%s:%d\\\\n' % (rel, line))\\nprint(len(results))\\n\"}\n</invoke_action>",
