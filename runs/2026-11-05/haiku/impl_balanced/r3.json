   "reply": "{\"action\": \"write\", \"path\": \"brackets.py\", \"content\": \"def balanced(s):\\n    \\\"\\\"\\\"Return True if every (, [ and { in s is closed in the correct order.\\n\\n    Text inside double-quoted strings is ignored. Inside a string, a backslash\\n    escapes the next character. An unterminated string makes the input unbalanced.\\n    \\\"\\\"\\\"\\n    pairs = {')': '(', ']': '[', '}': '{'}\\n    openers = set(pairs.values())\\n    stack = []\\n    in_string = False\\n    i = 0\\n    n = len(s)\\n\\n    while i < n:\\n        c = s[i]\\n        if in_string:\\n            if c == '\\\\\\\\':\\n                i += 2  # skip the escaped character\\n                continue\\n            if c == '\\\"':\\n                in_string = False\\n        else:\\n            if c == '\\\"':\\n                in_string = True\\n            elif c in openers:\\n                stack.append(c)\\n            elif c in pairs:\\n                if not stack or stack.pop() != pairs[c]:\\n                    return False\\n        i += 1\\n\\n    return not in_string and not stack\\n\"}",
