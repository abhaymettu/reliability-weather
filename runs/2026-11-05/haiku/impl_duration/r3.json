   "turn": 1,
   "reply": "\n<invoke:write\n{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"import re\\n\\n_PATTERN = re.compile(\\n    r'(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?'\\n)\\n\\n\\ndef parse_duration(s):\\n    \\\"\\\"\\\"Convert a duration string such as '1h30m' or '1d2h' into seconds.\\n\\n    Units d, h, m, s may each appear at most once, in that order. Each amount\\n    is a non-negative integer. Surrounding whitespace is allowed. Anything else\\n    (including an empty string or a bare number) raises ValueError.\\n    \\\"\\\"\\\"\\n    if not isinstance(s, str):\\n        raise ValueError(f\\\"expected a string, got {type(s).__name__}\\\")\\n\\n    text = s.strip()\\n    if not text:\\n        raise ValueError(\\\"empty duration string\\\")\\n\\n    match = _PATTERN.fullmatch(text)\\n    if match is None:\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    days, hours, minutes, seconds = match.groups()\\n    if days is None and hours is None and minutes is None and seconds is None:\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    multipliers = (86400, 3600, 60, 1)\\n    amounts = (days, hours, minutes, seconds)\\n    total = 0\\n    for amount, factor in zip(amounts, multipliers):\\n        if amount is not None:\\n            total += int(amount) * factor\\n    return total\\n\"}",
