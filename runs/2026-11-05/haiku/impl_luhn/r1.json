   "reply": "\n<invoke:\n{\"action\": \"write\", \"path\": \"luhn.py\", \"content\": \"\\\"\\\"\\\"Luhn checksum validation for card numbers.\\\"\\\"\\\"\\n\\nDIGITS = \\\"0123456789\\\"\\n\\n\\ndef valid(number):\\n    \\\"\\\"\\\"Return True if the string passes the Luhn check.\\n\\n    Spaces are removed before checking. Returns False if fewer than two\\n    characters remain, or if any remaining character is not a digit 0-9.\\n    \\\"\\\"\\\"\\n    stripped = number.replace(\\\" \\\", \\\"\\\")\\n\\n    if len(stripped) < 2:\\n        return False\\n    if any(ch not in DIGITS for ch in stripped):\\n        return False\\n\\n    total = 0\\n    # Walk from the rightmost digit; double every second digit.\\n    for position, ch in enumerate(reversed(stripped)):\\n        digit = int(ch)\\n        if position % 2 == 1:\\n            digit *= 2\\n            if digit > 9:\\n                digit -= 9\\n        total += digit\\n\\n    return total % 10 == 0\\n\"}",
