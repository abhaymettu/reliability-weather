   "reply": "\n<invoke_placeholder>\n{\"action\": \"write\", \"path\": \"luhn.py\", \"content\": \"\\\"\\\"\\\"Luhn checksum validation for card numbers.\\\"\\\"\\\"\\n\\n\\nDIGITS = \\\"0123456789\\\"\\n\\n\\ndef valid(number):\\n    \\\"\\\"\\\"Return True if the card number passes the Luhn check.\\n\\n    Spaces are removed before checking. The result is False if fewer than\\n    two characters remain or if any remaining character is not a digit 0-9.\\n    \\\"\\\"\\\"\\n    stripped = number.replace(\\\" \\\", \\\"\\\")\\n\\n    if len(stripped) < 2:\\n        return False\\n\\n    for ch in stripped:\\n        if ch not in DIGITS:\\n            return False\\n\\n    total = 0\\n    # Walk from the rightmost digit; double every second digit.\\n    for i, ch in enumerate(reversed(stripped)):\\n        d = int(ch)\\n        if i % 2 == 1:\\n            d *= 2\\n            if d > 9:\\n                d -= 9\\n        total += d\\n\\n    return total % 10 == 0\\n\"}",
