   "reply": "\n{\"action\": \"write\", \"path\": \"luhn.py\", \"content\": \"\\\"\\\"\\\"Luhn checksum validation for card numbers.\\\"\\\"\\\"\\n\\n\\ndef valid(number):\\n    \\\"\\\"\\\"Return True if the card number passes the Luhn check.\\n\\n    Single spaces are ignored. Returns False if fewer than two digits\\n    remain after removing spaces, or if any character is not 0-9.\\n    \\\"\\\"\\\"\\n    digits = number.replace(\\\" \\\", \\\"\\\")\\n\\n    if len(digits) < 2:\\n        return False\\n    if not all(c in \\\"0123456789\\\" for c in digits):\\n        return False\\n\\n    total = 0\\n    for position, char in enumerate(reversed(digits)):\\n        d = int(char)\\n        if position % 2 == 1:\\n            d *= 2\\n            if d > 9:\\n                d -= 9\\n        total += d\\n\\n    return total % 10 == 0\\n\"}",
