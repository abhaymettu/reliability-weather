   "reply": "\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _parse(version):\\n    \\\"\\\"\\\"Return a sort key for a SemVer string. Build metadata is ignored.\\\"\\\"\\\"\\n    # Drop build metadata (everything after the first '+').\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n\\n    # Split off the pre-release (everything after the first '-').\\n    if \\\"-\\\" in core_and_pre:\\n        core, pre = core_and_pre.split(\\\"-\\\", 1)\\n    else:\\n        core, pre = core_and_pre, None\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    # A version without a pre-release has higher precedence than any\\n    # version with one, so it gets the flag 1; pre-releases get 0.\\n    if pre is None:\\n        pre_key = (1, ())\\n    else:\\n        identifiers = []\\n        for ident in pre.split(\\\".\\\"):\\n            if ident.isdigit():\\n                # Numeric identifiers compare as integers and rank below\\n                # alphanumeric identifiers.\\n                identifiers.append((0, int(ident), \\\"\\\"))\\n            else:\\n                # Alphanumeric identifiers compare in ASCII order.\\n                identifiers.append((1, 0, ident))\\n        pre_key = (0, tuple(identifiers))\\n\\n    return (major, minor, patch, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the semantic version strings in vs sorted lowest precedence first.\\n\\n    Versions that compare equal keep their input order (sort is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_parse)\\n\"}",
