   "turn": 1,
   "reply": "\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _identifier_key(ident):\\n    # Numeric identifiers sort before alphanumeric ones; numeric compare as ints,\\n    # alphanumeric compare in ASCII (code point) order.\\n    if ident.isdigit() and ident.isascii():\\n        return (0, int(ident), \\\"\\\")\\n    return (1, 0, ident)\\n\\n\\ndef _version_key(version):\\n    # Build metadata (after '+') is ignored for precedence.\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n    if \\\"-\\\" in core_and_pre:\\n        core, pre = core_and_pre.split(\\\"-\\\", 1)\\n    else:\\n        core, pre = core_and_pre, None\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    if pre is None:\\n        # A release sorts above any pre-release of the same core version.\\n        return (major, minor, patch, 1, ())\\n\\n    # Pre-release: a shorter identifier list is lower when the shared prefix is equal,\\n    # which tuple comparison already gives us.\\n    pre_key = tuple(_identifier_key(ident) for ident in pre.split(\\\".\\\"))\\n    return (major, minor, patch, 0, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the versions sorted lowest precedence first.\\n\\n    Versions with equal precedence keep their input order (sorted() is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_version_key)\\n\"}",
