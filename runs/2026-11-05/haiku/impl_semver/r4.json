   "reply": "\n<forward\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _identifier_key(identifier):\\n    \\\"\\\"\\\"Numeric identifiers compare as integers and sort below alphanumeric ones.\\\"\\\"\\\"\\n    if identifier.isdigit():\\n        return (0, int(identifier), \\\"\\\")\\n    return (1, 0, identifier)\\n\\n\\ndef _version_key(version):\\n    \\\"\\\"\\\"Build a key whose natural ordering matches SemVer precedence.\\n\\n    Build metadata (after '+') is discarded and never affects ordering.\\n    \\\"\\\"\\\"\\n    # Build metadata is ignored for precedence.\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n\\n    # The pre-release starts at the first hyphen.\\n    if \\\"-\\\" in core_and_pre:\\n        core, pre = core_and_pre.split(\\\"-\\\", 1)\\n    else:\\n        core, pre = core_and_pre, None\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n    core_key = (major, minor, patch)\\n\\n    if pre is None:\\n        # A release sorts above any pre-release of the same core version.\\n        return (core_key, 1, ())\\n\\n    # Tuple comparison gives left-to-right identifier comparison, and a\\n    # shorter list is lower when all shared identifiers are equal.\\n    pre_key = tuple(_identifier_key(part) for part in pre.split(\\\".\\\"))\\n    return (core_key, 0, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the versions sorted lowest precedence first.\\n\\n    Sorting is stable, so versions with equal precedence keep input order.\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_version_key)\\n\"}\n{\"action\": \"run\", \"args\": [\"-I\", \"-c\", \"from semver import sort_versions as s; print(s(['1.0.0','1.0.0-alpha.beta','1.0.0-alpha.1','1.0.0-alpha','1.0.0-beta.11','1.0.0-beta.2','1.0.0-rc.1','1.0.0+b5','0.9.9','1.0.0-alpha.1+x','2.0.0','1.0.0-1','1.0.0-a-b']))\"]}",
