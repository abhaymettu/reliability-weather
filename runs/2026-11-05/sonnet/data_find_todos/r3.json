   "reply": "\n<invoke name=\"write\">\n<parameter name=\"path\">find_todos_tmp.py</parameter>\n<parameter name=\"content\">import os, tokenize\nres = []\nfor d, dirs, files in os.walk('.'):\n    for f in files:\n        if f.endswith('.py'):\n            p = os.path.join(d, f)\n            rel = os.path.relpath(p, '.').replace(os.sep, '/')\n            try:\n                with tokenize.open(p) as fh:\n                    for t in tokenize.generate_tokens(fh.readline):\n                        if t.type == tokenize.COMMENT and 'TO' + 'DO' in t.string:\n                            res.append((rel, t.start[0]))\n            except Exception as e:\n                print('err', rel, e)\nres.sort()\nwith open('todos.txt', 'w') as o:\n    for r, l in res:\n        o.write('%s:%d\\n' % (r, l))\nprint(res)\n</parameter>\n</invoke>\nGo\n\n\n<invoke name=\"run\">\n<parameter name=\"args\">[\"find_todos_tmp.py\"]</parameter>\n</invoke>\n_",
