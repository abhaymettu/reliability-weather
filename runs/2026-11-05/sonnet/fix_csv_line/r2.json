   "reply": "{\"action\": \"write\", \"path\": \"parse.py\", \"content\": \"def split_csv(line):\\n    fields = []\\n    cur = []\\n    in_quotes = False\\n    i = 0\\n    n = len(line)\\n    while i < n:\\n        c = line[i]\\n        if in_quotes:\\n            if c == '\\\"':\\n                if i + 1 < n and line[i + 1] == '\\\"':\\n                    cur.append('\\\"')\\n                    i += 1\\n                else:\\n                    in_quotes = False\\n            else:\\n                cur.append(c)\\n        else:\\n            if c == '\\\"':\\n                in_quotes = True\\n            elif c == ',':\\n                fields.append(''.join(cur))\\n                cur = []\\n            else:\\n                cur.append(c)\\n        i += 1\\n    fields.append(''.join(cur))\\n    return fields\\n\"}",
