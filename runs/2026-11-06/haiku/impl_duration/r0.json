   "reply": "\n{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"import re\\n\\n_PATTERN = re.compile(\\n    r\\\"\\\\s*(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?\\\\s*\\\"\\n)\\n\\n\\ndef parse_duration(s):\\n    \\\"\\\"\\\"Convert a duration string such as '1d2h', '1h30m' or '45s' into seconds.\\n\\n    Units d, h, m, s may each appear at most once, in that order. Each amount\\n    is a non-negative integer. Surrounding whitespace is allowed. Anything else,\\n    including an empty string or a bare number, raises ValueError.\\n    \\\"\\\"\\\"\\n    if not isinstance(s, str):\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    match = _PATTERN.fullmatch(s)\\n    if match is None or not any(g is not None for g in match.groups()):\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    days, hours, minutes, seconds = (\\n        int(g) if g is not None else 0 for g in match.groups()\\n    )\\n    return days * 86400 + hours * 3600 + minutes * 60 + seconds\\n\"}",
