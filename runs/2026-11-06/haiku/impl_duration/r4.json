   "turn": 1,
   "reply": "\n{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"import re\\n\\n_PATTERN = re.compile(\\n    r'^\\\\s*'\\n    r'(?:([0-9]+)d)?'\\n    r'(?:([0-9]+)h)?'\\n    r'(?:([0-9]+)m)?'\\n    r'(?:([0-9]+)s)?'\\n    r'\\\\s*$'\\n)\\n\\n_MULTIPLIERS = (86400, 3600, 60, 1)\\n\\n\\ndef parse_duration(s):\\n    \\\"\\\"\\\"Convert a duration string such as '1h30m' or '1d2h' into seconds.\\n\\n    Units d, h, m, s may each appear at most once, in that order. Each amount\\n    is a non-negative integer. Surrounding whitespace is allowed.\\n\\n    Raises ValueError for anything else, including an empty string.\\n    \\\"\\\"\\\"\\n    if not isinstance(s, str):\\n        raise ValueError(f\\\"expected a string, got {type(s).__name__}\\\")\\n\\n    match = _PATTERN.fullmatch(s)\\n    if match is None or not any(match.groups()):\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    total = 0\\n    for amount, multiplier in zip(match.groups(), _MULTIPLIERS):\\n        if amount is not None:\\n            total += int(amount) * multiplier\\n    return total\\n\"}",
