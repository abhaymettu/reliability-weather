   "reply": "\n{\"action\": \"write\", \"path\": \"luhn.py\", \"content\": \"\\\"\\\"\\\"Validate card numbers with the Luhn algorithm.\\\"\\\"\\\"\\n\\n_DIGITS = \\\"0123456789\\\"\\n\\n\\ndef valid(number):\\n    \\\"\\\"\\\"Return True if `number` passes the Luhn checksum.\\n\\n    Spaces are ignored. Returns False if, after removing spaces, the string\\n    has fewer than two characters or contains anything other than the ASCII\\n    digits 0-9.\\n    \\\"\\\"\\\"\\n    digits = number.replace(\\\" \\\", \\\"\\\")\\n\\n    if len(digits) < 2:\\n        return False\\n    if any(ch not in _DIGITS for ch in digits):\\n        return False\\n\\n    total = 0\\n    # Walk from the rightmost digit; double every second digit.\\n    for i, ch in enumerate(reversed(digits)):\\n        d = int(ch)\\n        if i % 2 == 1:\\n            d *= 2\\n            if d > 9:\\n                d -= 9\\n        total += d\\n\\n    return total % 10 == 0\\n\"}",
