   "turn": 1,
   "reply": "\n{\"action\": \"write\", \"path\": \"rle.py\", \"content\": \"import re\\n\\n\\ndef encode(s):\\n    \\\"\\\"\\\"Run-length encode s. Runs of length 1 omit the count.\\\"\\\"\\\"\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        j = i\\n        while j < n and s[j] == s[i]:\\n            j += 1\\n        count = j - i\\n        out.append(s[i])\\n        if count > 1:\\n            out.append(str(count))\\n        i = j\\n    return ''.join(out)\\n\\n\\ndef decode(s):\\n    \\\"\\\"\\\"Inverse of encode. Counts may have multiple digits.\\\"\\\"\\\"\\n    out = []\\n    for char, digits in re.findall(r'([A-Za-z])(\\\\d*)', s):\\n        count = int(digits) if digits else 1\\n        out.append(char * count)\\n    return ''.join(out)\\n\\n\\nif __name__ == '__main__':\\n    assert encode('aaabcc') == 'a3bc2'\\n    assert decode('a3bc2') == 'aaabcc'\\n    assert decode(encode('a' * 12 + 'b')) == 'a' * 12 + 'b'\\n    assert encode('') == ''\\n    assert decode('') == ''\\n    print('ok')\\n\"}",
