   "turn": 1,
   "reply": "\n<notepad>\n</notepad>\n{\"action\": \"write\", \"path\": \"rle.py\", \"content\": \"\\\"\\\"\\\"Run-length encoding for strings of letters.\\n\\nencode turns each run of the same character into the character followed by\\nthe run length, omitting the length when it is 1:\\n    encode('aaabcc') == 'a3bc2'\\n\\ndecode is the exact inverse of encode.\\n\\\"\\\"\\\"\\n\\n\\ndef encode(s):\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        ch = s[i]\\n        j = i\\n        while j < n and s[j] == ch:\\n            j += 1\\n        count = j - i\\n        out.append(ch)\\n        if count > 1:\\n            out.append(str(count))\\n        i = j\\n    return ''.join(out)\\n\\n\\ndef decode(s):\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        ch = s[i]\\n        i += 1\\n        start = i\\n        while i < n and s[i].isdigit():\\n            i += 1\\n        count = int(s[start:i]) if i > start else 1\\n        out.append(ch * count)\\n    return ''.join(out)\\n\\n\\nif __name__ == '__main__':\\n    assert encode('aaabcc') == 'a3bc2'\\n    assert decode('a3bc2') == 'aaabcc'\\n    assert decode(encode('')) == ''\\n    assert decode(encode('a' * 12 + 'b')) == 'a' * 12 + 'b'\\n    assert encode('a' * 12 + 'b') == 'a12b'\\n    print('ok')\\n\"}",
