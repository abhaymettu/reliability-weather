   "turn": 1,
   "reply": "\n{\"action\": \"write\", \"path\": \"rle.py\", \"content\": \"\\\"\\\"\\\"Run-length encoding for strings of letters.\\n\\nencode turns each run of the same character into the character followed by\\nthe run length, omitting the length when it is 1:\\n    encode('aaabcc') == 'a3bc2'\\n\\ndecode is the exact inverse of encode and supports multi-digit run lengths.\\n\\\"\\\"\\\"\\n\\n\\ndef encode(s):\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        ch = s[i]\\n        j = i\\n        while j < n and s[j] == ch:\\n            j += 1\\n        count = j - i\\n        out.append(ch)\\n        if count > 1:\\n            out.append(str(count))\\n        i = j\\n    return ''.join(out)\\n\\n\\ndef decode(s):\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        ch = s[i]\\n        i += 1\\n        j = i\\n        while j < n and s[j].isdigit():\\n            j += 1\\n        count = int(s[i:j]) if j > i else 1\\n        out.append(ch * count)\\n        i = j\\n    return ''.join(out)\\n\\n\\nif __name__ == '__main__':\\n    assert encode('aaabcc') == 'a3bc2'\\n    assert decode('a3bc2') == 'aaabcc'\\n    assert encode('') == '' and decode('') == ''\\n    long_run = 'x' * 12 + 'y'\\n    assert decode(encode(long_run)) == long_run\\n    assert encode(long_run) == 'x12y'\\n    print('ok')\\n\"}",
   "result": "wrote rle.py (1164 chars)"
