   "reply": "{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _identifier_key(ident):\\n    # Numeric identifiers compare as integers and sort below alphanumeric ones.\\n    # The leading flag keeps the two kinds from being compared directly.\\n    if ident.isdigit():\\n        return (0, int(ident), \\\"\\\")\\n    return (1, 0, ident)\\n\\n\\ndef _precedence_key(version):\\n    # Build metadata after '+' is ignored for ordering.\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n\\n    # The pre-release starts at the first hyphen.\\n    if \\\"-\\\" in core_and_pre:\\n        core, pre = core_and_pre.split(\\\"-\\\", 1)\\n    else:\\n        core, pre = core_and_pre, None\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    if pre is None:\\n        # A release sorts above any pre-release of the same core version.\\n        pre_key = (1,)\\n    else:\\n        # Tuple comparison makes a shorter identifier list lower when it is a prefix.\\n        pre_key = (0, tuple(_identifier_key(i) for i in pre.split(\\\".\\\")))\\n\\n    return (major, minor, patch, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the version strings in ascending SemVer precedence.\\n\\n    Versions that compare equal keep their input order (sorted() is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_precedence_key)\\n\"}",
