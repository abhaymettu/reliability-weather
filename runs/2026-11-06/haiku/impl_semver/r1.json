   "turn": 1,
   "reply": "\n<invoke:write\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _key(version):\\n    # Build metadata is ignored for precedence.\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n    # Pre-release identifiers may contain hyphens; core never does,\\n    # so split only on the first hyphen.\\n    core, sep, pre = core_and_pre.partition(\\\"-\\\")\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    if not sep:\\n        # A release version sorts above any pre-release of the same core.\\n        return (major, minor, patch, 1, ())\\n\\n    identifiers = []\\n    for ident in pre.split(\\\".\\\"):\\n        if ident.isdigit():\\n            # Numeric identifiers compare as integers and rank below alphanumeric.\\n            identifiers.append((0, int(ident), \\\"\\\"))\\n        else:\\n            # Alphanumeric identifiers compare in ASCII order.\\n            identifiers.append((1, 0, ident))\\n    # Tuple comparison gives: shorter list lower when shared parts are equal.\\n    return (major, minor, patch, 0, tuple(identifiers))\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the versions sorted lowest precedence first.\\n\\n    Versions with equal precedence keep their input order (sorted is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_key)\\n\"}",
