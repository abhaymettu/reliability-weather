   "reply": "\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _identifier_key(ident):\\n    \\\"\\\"\\\"Numeric identifiers sort before alphanumeric ones; each group is ordered naturally.\\\"\\\"\\\"\\n    if ident.isdigit():\\n        return (0, int(ident), \\\"\\\")\\n    return (1, 0, ident)\\n\\n\\ndef _key(version):\\n    \\\"\\\"\\\"Build a sort key that reflects SemVer precedence. Build metadata is ignored.\\\"\\\"\\\"\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n    core, _, pre = core_and_pre.partition(\\\"-\\\")\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    if pre:\\n        # A pre-release is lower than the same version without one.\\n        release_flag = 0\\n        pre_key = tuple(_identifier_key(ident) for ident in pre.split(\\\".\\\"))\\n    else:\\n        release_flag = 1\\n        pre_key = ()\\n\\n    # Tuple comparison gives the required behaviour: a shorter list is lower\\n    # when all shared identifiers are equal.\\n    return (major, minor, patch, release_flag, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the versions sorted lowest precedence first.\\n\\n    Python's sort is stable, so versions that tie keep their input order.\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_key)\\n\"}\n{\"action\": \"finish\"}",
