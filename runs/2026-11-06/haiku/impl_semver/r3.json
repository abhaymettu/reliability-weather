   "reply": "\n<invoke_placeholder>\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _precedence_key(version):\\n    \\\"\\\"\\\"Return a key that orders versions by SemVer 2.0.0 precedence.\\n\\n    Build metadata (after '+') is ignored. Ties keep input order because\\n    Python's sort is stable.\\n    \\\"\\\"\\\"\\n    # Build metadata does not affect precedence.\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n\\n    # Split off the optional pre-release (after the first '-').\\n    if \\\"-\\\" in core_and_pre:\\n        core, pre = core_and_pre.split(\\\"-\\\", 1)\\n    else:\\n        core, pre = core_and_pre, None\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n    core_key = (major, minor, patch)\\n\\n    if pre is None:\\n        # A release version is higher than any pre-release of the same core.\\n        return (core_key, 1, ())\\n\\n    identifiers = []\\n    for ident in pre.split(\\\".\\\"):\\n        if ident.isdigit():\\n            # Numeric identifiers compare as integers and sort below alphanumeric ones.\\n            identifiers.append((0, int(ident), \\\"\\\"))\\n        else:\\n            # Alphanumeric identifiers compare in ASCII order.\\n            identifiers.append((1, 0, ident))\\n    # Tuples compare element-wise, so a shorter list that is a prefix sorts lower.\\n    return (core_key, 0, tuple(identifiers))\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the version strings in vs sorted by SemVer precedence, lowest first.\\\"\\\"\\\"\\n    return sorted(vs, key=_precedence_key)\\n\"}",
