   "turn": 1,
   "reply": "\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"# Sort semantic version strings by SemVer 2.0.0 precedence.\\n\\n\\ndef _parse(v):\\n    # Build metadata after '+' is ignored for ordering. Split it off first,\\n    # since build metadata may itself contain hyphens.\\n    core_part = v.split('+', 1)[0]\\n    # The pre-release starts at the first hyphen (core parts never contain one).\\n    if '-' in core_part:\\n        core, pre = core_part.split('-', 1)\\n    else:\\n        core, pre = core_part, None\\n\\n    major, minor, patch = (int(x) for x in core.split('.'))\\n\\n    if pre is None:\\n        # A release sorts above any pre-release of the same version.\\n        pre_key = (1, ())\\n    else:\\n        ids = []\\n        for ident in pre.split('.'):\\n            if ident.isascii() and ident.isdigit():\\n                # Numeric identifiers compare as integers and sort below alphanumeric ones.\\n                ids.append((0, int(ident), ''))\\n            else:\\n                # Alphanumeric identifiers compare in ASCII order.\\n                ids.append((1, 0, ident))\\n        # Tuple comparison handles left-to-right order and shorter-prefix-is-lower.\\n        pre_key = (0, tuple(ids))\\n\\n    return (major, minor, patch, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    # sorted() is stable, so versions that tie keep their input order.\\n    return sorted(vs, key=_parse)\\n\"}",
