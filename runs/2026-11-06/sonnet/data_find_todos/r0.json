   "reply": "\n<invoke name=\"write\">\n<parameter name=\"path\">scan_tmp.py</parameter>\n<parameter name=\"content\">import os, tokenize\nkey = 'TO' + 'DO'\nme = os.path.abspath(__file__)\nres = []\nfor d, dirs, files in os.walk('.'):\n    for f in files:\n        if not f.endswith('.py'):\n            continue\n        p = os.path.join(d, f)\n        if os.path.abspath(p) == me:\n            continue\n        rel = os.path.relpath(p, '.').replace(os.sep, '/')\n        try:\n            with open(p, 'rb') as fh:\n                for t in tokenize.tokenize(fh.readline):\n                    if t.type == tokenize.COMMENT and key in t.string:\n                        res.append((rel, t.start[0]))\n        except Exception as e:\n            print('fail', rel, e)\nres = sorted(set(res))\nwith open('todos.txt', 'w') as o:\n    o.write(''.join('%s:%d\\n' % r for r in res))\nprint(res)\nos.remove(me)\n</parameter>\n</invoke>\n\nZ",
