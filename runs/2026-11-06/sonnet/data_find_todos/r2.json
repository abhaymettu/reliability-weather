   "reply": "\n<invoke name=\"write\">\n<parameter name=\"path\">find_t.py</parameter>\n<parameter name=\"content\">import os, tokenize\nkey = 'TO' + 'DO'\nres = []\nfor d, ds, fs in os.walk('.'):\n    ds[:] = [x for x in ds if x != '.git']\n    for f in fs:\n        if not f.endswith('.py'):\n            continue\n        p = os.path.join(d, f)\n        rel = os.path.relpath(p, '.').replace(os.sep, '/')\n        try:\n            with tokenize.open(p) as fh:\n                for t in tokenize.generate_tokens(fh.readline):\n                    if t.type == tokenize.COMMENT and key in t.string:\n                        res.append((rel, t.start[0]))\n        except Exception as e:\n            print('ERR', rel, e)\nres.sort()\nwith open('todos.txt', 'w') as o:\n    for r, l in res:\n        o.write('%s:%d\\n' % (r, l))\nprint(res)\n</parameter>\n</invoke>\n= None",
