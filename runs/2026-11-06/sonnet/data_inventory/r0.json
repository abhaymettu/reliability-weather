   "reply": "\n<invoke>\n<parameter name=\"action\">write</parameter>\n<parameter name=\"path\">process.py</parameter>\n<parameter name=\"content\">import json\ninv = json.load(open(\"inventory.json\"))\nrej = []\nfor n, line in enumerate(open(\"transactions.txt\").read().splitlines(), 1):\n    p = line.split()\n    if not p:\n        continue\n    try:\n        op, sku, q = p[0].lower(), p[1], int(p[2])\n        if len(p) != 3 or q < 0 or op not in (\"add\", \"remove\"):\n            raise ValueError\n    except (ValueError, IndexError):\n        rej.append(n)\n        continue\n    if op == \"add\":\n        inv[sku] = inv.get(sku, 0) + q\n    elif sku in inv and inv[sku] >= q:\n        inv[sku] -= q\n    else:\n        rej.append(n)\njson.dump(inv, open(\"inventory_after.json\", \"w\"), indent=2)\nopen(\"rejected.txt\", \"w\").write(\"\".join(f\"{n}\\n\" for n in rej))\nprint(inv, rej)\n</parameter>\n</invoke>",
