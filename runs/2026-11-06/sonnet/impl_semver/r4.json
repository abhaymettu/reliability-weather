   "reply": "{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"def _key(v):\\n    v = v.split('+', 1)[0]\\n    if '-' in v:\\n        core, pre = v.split('-', 1)\\n    else:\\n        core, pre = v, None\\n    nums = tuple(int(x) for x in core.split('.'))\\n    if pre is None:\\n        return (nums, 1, ())\\n    ids = []\\n    for p in pre.split('.'):\\n        if p.isdigit():\\n            ids.append((0, int(p), ''))\\n        else:\\n            ids.append((1, 0, p))\\n    return (nums, 0, tuple(ids))\\n\\n\\ndef sort_versions(vs):\\n    return sorted(vs, key=_key)\\n\"}",
