   "reply": "{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Semantic version sorting per SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\nimport re\\n\\n_SEMVER_RE = re.compile(\\n    r\\\"^(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)\\\"\\n    r\\\"(?:-([0-9A-Za-z-]+(?:\\\\.[0-9A-Za-z-]+)*))?\\\"\\n    r\\\"(?:\\\\+[0-9A-Za-z-]+(?:\\\\.[0-9A-Za-z-]+)*)?$\\\"\\n)\\n\\n\\ndef _parse(v):\\n    m = _SEMVER_RE.match(v)\\n    if not m:\\n        raise ValueError(\\\"invalid semantic version: %r\\\" % (v,))\\n    major, minor, patch, prerelease = m.groups()\\n    key = (int(major), int(minor), int(patch))\\n    if prerelease is None:\\n        return key + ((1,),)\\n    ids = []\\n    for ident in prerelease.split(\\\".\\\"):\\n        if ident.isdigit():\\n            ids.append((0, int(ident), \\\"\\\"))\\n        else:\\n            ids.append((1, 0, ident))\\n    return key + ((0, tuple(ids)),)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return versions sorted by SemVer 2.0.0 precedence, lowest first, stable.\\\"\\\"\\\"\\n    return sorted(vs, key=_parse)\\n\"}\n\n{\"action\": \"run\", \"args\": [\"-c\", \"from semver import sort_versions\\nprint(sort_versions(['1.0.0','1.0.0-alpha','1.0.0-alpha.1','1.0.0-alpha.beta','1.0.0-beta','1.0.0-beta.2','1.0.0-beta.11','1.0.0-rc.1','1.0.0+build.5','2.0.0','1.0.0-alpha.1+meta']))\\nprint(sort_versions(['1.0.0+b','1.0.0+a']))\"]}",
