   "reply": "{\"action\": \"write\", \"path\": \"todo_scan.py\", \"content\": \"import os\\nimport tokenize\\n\\nroot = os.getcwd()\\nresults = set()\\n\\nfor dirpath, dirnames, filenames in os.walk(root):\\n    dirnames[:] = [d for d in dirnames if d != '.git']\\n    for fn in filenames:\\n        if not fn.endswith('.py'):\\n            continue\\n        full = os.path.join(dirpath, fn)\\n        rel = os.path.relpath(full, root).replace(os.sep, '/')\\n        try:\\n            with open(full, 'rb') as fb:\\n                for tok in tokenize.tokenize(fb.readline):\\n                    if tok.type == tokenize.COMMENT and 'TODO' in tok.string:\\n                        results.add((rel, tok.start[0]))\\n        except Exception:\\n            pass\\n\\nlines = ['%s:%d' % (rel, line) for rel, line in sorted(results)]\\nwith open(os.path.join(root, 'todos.txt'), 'w', encoding='utf-8') as out:\\n    for ln in lines:\\n        out.write(ln + '\\\\n')\\nprint('\\\\n'.join(lines))\\n\"}",
