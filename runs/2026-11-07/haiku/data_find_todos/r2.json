   "reply": "\n{\"action\": \"write\", \"path\": \"/tmp/todo_scan/scan.py\", \"content\": \"import io\\nimport os\\nimport sys\\nimport tokenize\\n\\nroot = os.path.abspath(sys.argv[1]) if len(sys.argv) > 1 else os.getcwd()\\nresults = []\\n\\nfor dp, dns, fns in os.walk(root):\\n    dns[:] = [d for d in dns if d != '.git']\\n    for fn in fns:\\n        if not fn.endswith('.py'):\\n            continue\\n        full = os.path.join(dp, fn)\\n        rel = os.path.relpath(full, root).replace(os.sep, '/')\\n        try:\\n            with tokenize.open(full) as f:\\n                src = f.read()\\n            for t in tokenize.generate_tokens(io.StringIO(src).readline):\\n                if t.type == tokenize.COMMENT and 'TODO' in t.string:\\n                    results.append((rel, t.start[0]))\\n        except (SyntaxError, tokenize.TokenError, UnicodeDecodeError, OSError) as e:\\n            sys.stderr.write('skip %s: %s\\\\n' % (rel, e))\\n\\nresults.sort()\\nwith open(os.path.join(os.getcwd(), 'todos.txt'), 'w') as out:\\n    for rel, ln in results:\\n        out.write('%s:%d\\\\n' % (rel, ln))\\nprint('found %d' % len(results))\\n\"}",
