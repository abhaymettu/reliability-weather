   "reply": "{\"action\": \"write\", \"path\": \"find_todos.py\", \"content\": \"import os\\nimport sys\\nimport tokenize\\nfrom pathlib import Path\\n\\nroot = Path('.').resolve()\\nresults = []\\nfor dirpath, dirnames, filenames in os.walk(root):\\n    dirnames[:] = [d for d in dirnames if d != '.git']\\n    for fn in filenames:\\n        if not fn.endswith('.py'):\\n            continue\\n        p = Path(dirpath) / fn\\n        rel = p.relative_to(root).as_posix()\\n        try:\\n            with open(p, 'rb') as f:\\n                for tok in tokenize.tokenize(f.readline):\\n                    if tok.type == tokenize.COMMENT and 'TODO' in tok.string:\\n                        results.append((rel, tok.start[0]))\\n        except (tokenize.TokenError, SyntaxError, OSError, UnicodeDecodeError) as e:\\n            print('skipped ' + rel + ': ' + str(e), file=sys.stderr)\\nresults.sort()\\nwith open('todos.txt', 'w') as out:\\n    for rel, line in results:\\n        out.write(f'{rel}:{line}\\\\n')\\nprint(len(results))\\n\"}",
