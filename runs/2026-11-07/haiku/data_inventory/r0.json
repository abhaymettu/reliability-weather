   "reply": "{\"action\": \"write\", \"path\": \"tools/apply_txn.py\", \"content\": \"import json\\nimport sys\\n\\ninv_path, txn_path, out_path, rej_path = sys.argv[1:5]\\n\\nwith open(inv_path, encoding=\\\"utf-8\\\") as f:\\n    data = json.load(f)\\nstock = {str(k): int(v) for k, v in data.items()}\\n\\nrejected = []\\nwith open(txn_path, encoding=\\\"utf-8\\\") as f:\\n    for n, line in enumerate(f, 1):\\n        parts = line.split()\\n        if not parts:\\n            continue\\n        if len(parts) != 3:\\n            rejected.append(n)\\n            continue\\n        op, sku, qs = parts\\n        op = op.lower()\\n        try:\\n            qty = int(qs)\\n        except ValueError:\\n            rejected.append(n)\\n            continue\\n        if qty < 0:\\n            rejected.append(n)\\n        elif op == \\\"add\\\":\\n            stock[sku] = stock.get(sku, 0) + qty\\n        elif op == \\\"remove\\\":\\n            if sku in stock and stock[sku] - qty >= 0:\\n                stock[sku] -= qty\\n            else:\\n                rejected.append(n)\\n        else:\\n            rejected.append(n)\\n\\nwith open(out_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n    json.dump(stock, f, indent=2)\\n    f.write(\\\"\\\\n\\\")\\nwith open(rej_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n    for n in rejected:\\n        f.write(f\\\"{n}\\\\n\\\")\\n\"}",
