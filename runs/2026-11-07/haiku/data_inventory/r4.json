   "reply": "\n<invoke_placeholder>\n{\"action\": \"write\", \"path\": \"scripts/solve_inventory.py\", \"content\": \"import json\\nimport sys\\n\\nINV = \\\"inventory.json\\\"\\nTX = \\\"transactions.txt\\\"\\nOUT_INV = \\\"inventory_after.json\\\"\\nOUT_REJ = \\\"rejected.txt\\\"\\n\\nwith open(INV, encoding=\\\"utf-8\\\") as f:\\n    counts = json.load(f)\\n\\nrejected = []\\n\\nwith open(TX, encoding=\\\"utf-8\\\") as f:\\n    for lineno, raw in enumerate(f, start=1):\\n        line = raw.strip()\\n        if not line:\\n            continue\\n        parts = line.split()\\n        ok = False\\n        if len(parts) == 3 and parts[0] in (\\\"add\\\", \\\"remove\\\"):\\n            op, sku, qty_s = parts\\n            try:\\n                qty = int(qty_s)\\n            except ValueError:\\n                qty = None\\n            if qty is not None and qty >= 0:\\n                if op == \\\"add\\\":\\n                    counts[sku] = counts.get(sku, 0) + qty\\n                    ok = True\\n                else:\\n                    if sku in counts and counts[sku] - qty >= 0:\\n                        counts[sku] = counts[sku] - qty\\n                        ok = True\\n        if not ok:\\n            rejected.append(lineno)\\n\\nwith open(OUT_INV, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n    json.dump(counts, f, indent=2)\\n    f.write(\\\"\\\\n\\\")\\n\\nwith open(OUT_REJ, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n    for n in rejected:\\n        f.write(f\\\"{n}\\\\n\\\")\\n\\nprint(f\\\"applied; rejected={len(rejected)}; skus={len(counts)}\\\")\\n\"}",
