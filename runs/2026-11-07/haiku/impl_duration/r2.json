   "turn": 2,
   "reply": "{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"import re\\n\\n_PATTERN = re.compile(r\\\"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?\\\")\\n_UNIT_SECONDS = (86400, 3600, 60, 1)\\n\\n\\ndef parse_duration(s):\\n    \\\"\\\"\\\"Convert a duration string such as '1h30m' or '1d2h' into whole seconds.\\n\\n    Units are d, h, m and s. Each unit may appear at most once and must be in\\n    that order. Surrounding whitespace is allowed. Anything else raises ValueError.\\n    \\\"\\\"\\\"\\n    if not isinstance(s, str):\\n        raise ValueError(f\\\"duration must be a string, not {type(s).__name__}\\\")\\n\\n    text = s.strip()\\n    if not text:\\n        raise ValueError(\\\"empty duration\\\")\\n\\n    match = _PATTERN.fullmatch(text)\\n    if match is None or not any(g is not None for g in match.groups()):\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    return sum(\\n        int(amount) * unit\\n        for amount, unit in zip(match.groups(), _UNIT_SECONDS)\\n        if amount is not None\\n    )\\n\"}",
