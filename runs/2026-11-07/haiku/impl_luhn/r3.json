   "reply": "\n<invoke/>\n{\"action\": \"write\", \"path\": \"luhn.py\", \"content\": \"\\\"\\\"\\\"Validate card numbers with the Luhn algorithm.\\\"\\\"\\\"\\n\\nDIGITS = \\\"0123456789\\\"\\n\\n\\ndef valid(number):\\n    \\\"\\\"\\\"Return True if the card number passes the Luhn check.\\n\\n    Spaces are removed before checking. The input is invalid (returns False)\\n    if it has fewer than two characters after removing spaces, or if it\\n    contains any character other than the digits 0-9.\\n    \\\"\\\"\\\"\\n    digits = number.replace(\\\" \\\", \\\"\\\")\\n\\n    if len(digits) < 2:\\n        return False\\n    if any(ch not in DIGITS for ch in digits):\\n        return False\\n\\n    total = 0\\n    # Walk from the rightmost digit to the leftmost.\\n    for index, ch in enumerate(reversed(digits)):\\n        value = ord(ch) - ord(\\\"0\\\")\\n        if index % 2 == 1:\\n            value *= 2\\n            if value > 9:\\n                value -= 9\\n        total += value\\n\\n    return total % 10 == 0\\n\"}\n</invoke>\n>",
