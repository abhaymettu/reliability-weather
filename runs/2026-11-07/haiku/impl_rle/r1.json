   "turn": 1,
   "reply": "\n<parameter_type>\n{\"action\": \"write\", \"path\": \"rle.py\", \"content\": \"import re\\n\\n\\ndef encode(s):\\n    \\\"\\\"\\\"Run-length encode a string of letters.\\n\\n    A run of one character is written as just the character; longer runs are\\n    written as the character followed by the run length.\\n    \\\"\\\"\\\"\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        ch = s[i]\\n        j = i\\n        while j < n and s[j] == ch:\\n            j += 1\\n        count = j - i\\n        out.append(ch)\\n        if count > 1:\\n            out.append(str(count))\\n        i = j\\n    return ''.join(out)\\n\\n\\ndef decode(s):\\n    \\\"\\\"\\\"Inverse of encode: expand each character followed by an optional count.\\\"\\\"\\\"\\n    out = []\\n    for ch, digits in re.findall(r'(\\\\D)(\\\\d*)', s):\\n        count = int(digits) if digits else 1\\n        out.append(ch * count)\\n    return ''.join(out)\\n\\n\\nif __name__ == '__main__':\\n    assert encode('aaabcc') == 'a3bc2'\\n    assert decode('a3bc2') == 'aaabcc'\\n    assert encode('') == '' and decode('') == ''\\n    assert decode(encode('a' * 12 + 'b')) == 'a' * 12 + 'b'\\n    assert encode('a' * 12 + 'b') == 'a12b'\\n    print('ok')\\n\"}\n</parameter_type>\n</invoke>",
