   "turn": 1,
   "reply": "\n<invoke_action>\n{\"action\": \"write\", \"path\": \"rle.py\", \"content\": \"import re\\n\\n\\ndef encode(s):\\n    \\\"\\\"\\\"Run-length encode a string of letters.\\n\\n    Each run of the same character becomes the character followed by the\\n    run length, omitted when the length is 1: 'aaabcc' -> 'a3bc2'.\\n    \\\"\\\"\\\"\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        ch = s[i]\\n        j = i\\n        while j < n and s[j] == ch:\\n            j += 1\\n        count = j - i\\n        out.append(ch)\\n        if count > 1:\\n            out.append(str(count))\\n        i = j\\n    return ''.join(out)\\n\\n\\ndef decode(s):\\n    \\\"\\\"\\\"Inverse of encode: expand runs such as 'a3bc2' -> 'aaabcc'.\\n\\n    Run lengths may have more than one digit, e.g. 'a12' -> 'a' * 12.\\n    \\\"\\\"\\\"\\n    out = []\\n    for match in re.finditer(r'([A-Za-z])(\\\\d*)', s):\\n        ch, digits = match.group(1), match.group(2)\\n        count = int(digits) if digits else 1\\n        out.append(ch * count)\\n    return ''.join(out)\\n\"}\n{\"action\": \"finish\"}\n<br>",
