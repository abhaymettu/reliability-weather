   "turn": 1,
   "reply": "\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n_DIGITS = frozenset(\\\"0123456789\\\")\\n\\n\\ndef _identifier_key(ident):\\n    # Numeric identifiers sort before alphanumeric ones; numeric compare as\\n    # integers; alphanumeric compare in ASCII order.\\n    if ident and all(c in _DIGITS for c in ident):\\n        return (0, int(ident), \\\"\\\")\\n    return (1, 0, ident)\\n\\n\\ndef _key(version):\\n    # Build metadata (after '+') is ignored for precedence.\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n    # The first hyphen separates the core version from the pre-release.\\n    core, _, pre = core_and_pre.partition(\\\"-\\\")\\n    numbers = tuple(int(part) for part in core.split(\\\".\\\"))\\n    if pre:\\n        # A pre-release sorts lower than the release with the same core.\\n        ids = tuple(_identifier_key(p) for p in pre.split(\\\".\\\"))\\n        return (numbers, 0, ids)\\n    # Release: no pre-release identifiers. Tuple comparison makes a shorter\\n    # identifier list lower when all shared identifiers are equal.\\n    return (numbers, 1, ())\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the versions sorted lowest precedence first.\\n\\n    Versions that compare equal keep their input order (sorted is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_key)\\n\"}",
