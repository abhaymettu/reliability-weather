   "reply": "\n<invoke_tool_placeholder>\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _identifier_key(ident):\\n    # Numeric identifiers sort before alphanumeric ones; numeric compare as ints.\\n    if ident.isdigit():\\n        return (0, int(ident), \\\"\\\")\\n    # Alphanumeric identifiers compare in ASCII order.\\n    return (1, 0, ident)\\n\\n\\ndef _version_key(version):\\n    # Build metadata (after '+') is ignored for precedence.\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n\\n    if \\\"-\\\" in core_and_pre:\\n        core, pre = core_and_pre.split(\\\"-\\\", 1)\\n    else:\\n        core, pre = core_and_pre, None\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    if pre is None:\\n        # A release version has higher precedence than any pre-release of it.\\n        pre_key = (1, ())\\n    else:\\n        # Tuple comparison handles left-to-right order and the\\n        # shorter-list-is-lower rule automatically.\\n        pre_key = (0, tuple(_identifier_key(i) for i in pre.split(\\\".\\\")))\\n\\n    return (major, minor, patch, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the versions sorted lowest precedence first.\\n\\n    Python's sort is stable, so versions that compare equal keep their\\n    input order.\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_version_key)\\n\"}",
