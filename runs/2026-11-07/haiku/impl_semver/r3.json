   "reply": "\n<parameter_type_placeholder>\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _parse(version):\\n    \\\"\\\"\\\"Return a sort key for a SemVer string.\\n\\n    Build metadata (after '+') is discarded. A version without a pre-release\\n    gets a flag higher than any pre-release, so it sorts after them.\\n    \\\"\\\"\\\"\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n    if \\\"-\\\" in core_and_pre:\\n        core, pre = core_and_pre.split(\\\"-\\\", 1)\\n    else:\\n        core, pre = core_and_pre, None\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    if pre is None:\\n        pre_key = (1, ())\\n    else:\\n        identifiers = []\\n        for ident in pre.split(\\\".\\\"):\\n            if ident.isdigit():\\n                # Numeric identifiers compare as integers and sort below alphanumeric ones.\\n                identifiers.append((0, int(ident), \\\"\\\"))\\n            else:\\n                # Alphanumeric identifiers compare in ASCII order.\\n                identifiers.append((1, 0, ident))\\n        pre_key = (0, tuple(identifiers))\\n\\n    return (major, minor, patch, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the version strings in vs sorted by SemVer precedence, lowest first.\\n\\n    Versions that compare equal keep their input order (the sort is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_parse)\\n\"}",
