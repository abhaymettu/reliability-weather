   "reply": "\n<invoke name=\"write\">\n<parameter name=\"path\">find_todos.py</parameter>\n<parameter name=\"content\">import os, tokenize\nres = []\nfor d, dirs, files in os.walk('.'):\n    for f in files:\n        if f.endswith('.py'):\n            p = os.path.join(d, f)\n            rel = os.path.relpath(p, '.').replace(os.sep, '/')\n            try:\n                with open(p, 'rb') as fh:\n                    for t in tokenize.tokenize(fh.readline):\n                        if t.type == tokenize.COMMENT and 'TODO' in t.string:\n                            res.append((rel, t.start[0]))\n            except Exception as e:\n                print('error', rel, e)\nres.sort()\nwith open('todos.txt', 'w') as o:\n    for r, l in res:\n        o.write('%s:%d\\n' % (r, l))\nprint(res)\n</parameter>\n</invoke>\nispatch\n\n\n<invoke name=\"run\">\n<parameter name=\"args\">[\"find_todos.py\"]</parameter>\n</invoke>\n\n\n\n<invoke name=\"finish\">\n</invoke>",
