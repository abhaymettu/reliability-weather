   "reply": "\n<invoke name=\"write\">\n<parameter name=\"path\">find_todos.py</parameter>\n<parameter name=\"content\">import os, tokenize\n\nres = []\nfor root, dirs, files in os.walk('.'):\n    dirs[:] = [d for d in dirs if d != '.git']\n    for f in files:\n        if not f.endswith('.py'):\n            continue\n        p = os.path.join(root, f)\n        rel = os.path.relpath(p, '.').replace(os.sep, '/')\n        try:\n            with open(p, 'rb') as fh:\n                for t in tokenize.tokenize(fh.readline):\n                    if t.type == tokenize.COMMENT and 'TODO' in t.string:\n                        res.append((rel, t.start[0]))\n        except Exception:\n            pass\nres.sort()\nwith open('todos.txt', 'w') as out:\n    for r, l in res:\n        out.write('%s:%d\\n' % (r, l))\nprint(res)\n</parameter>\n</invoke>\n</invoke>",
