   "reply": "\n<invoke name=\"write\">\n<parameter name=\"path\">apply.py</parameter>\n<parameter name=\"content\">import json\ninv = json.load(open(\"inventory.json\"))\nrej = []\nfor n, line in enumerate(open(\"transactions.txt\").read().splitlines(), 1):\n    p = line.split()\n    if not p:\n        continue\n    try:\n        if len(p) != 3:\n            raise ValueError\n        act, sku, q = p[0].lower(), p[1], int(p[2])\n        if q < 0 or act not in (\"add\", \"remove\"):\n            raise ValueError\n    except ValueError:\n        rej.append(n)\n        continue\n    if act == \"add\":\n        inv[sku] = inv.get(sku, 0) + q\n    elif sku not in inv or inv[sku] < q:\n        rej.append(n)\n    else:\n        inv[sku] -= q\njson.dump(inv, open(\"inventory_after.json\", \"w\"), indent=2)\nopen(\"rejected.txt\", \"w\").write(\"\".join(f\"{r}\\n\" for r in rej))\nprint(inv, rej)\n</parameter>\n</invoke>",
