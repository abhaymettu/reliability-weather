   "reply": "{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"import re\\n\\n_PATTERN = re.compile(r'(?:(\\\\d+)d)?(?:(\\\\d+)h)?(?:(\\\\d+)m)?(?:(\\\\d+)s)?', re.ASCII)\\n_MULT = (86400, 3600, 60, 1)\\n\\n\\ndef parse_duration(s):\\n    if not isinstance(s, str):\\n        raise ValueError('duration must be a string')\\n    s = s.strip()\\n    m = _PATTERN.fullmatch(s)\\n    if not s or m is None:\\n        raise ValueError('invalid duration: %r' % s)\\n    return sum(int(g) * k for g, k in zip(m.groups(), _MULT) if g is not None)\\n\"}",
