   "turn": 1,
   "reply": "\n\n{\"action\": \"write\", \"path\": \"intervals.py\", \"content\": \"def merge(intervals):\\n    \\\"\\\"\\\"Merge overlapping or touching [start, end] intervals.\\n\\n    Returns a new list of disjoint intervals sorted by start.\\n    The input list and its inner lists are not modified.\\n    \\\"\\\"\\\"\\n    pairs = sorted((list(iv) for iv in intervals), key=lambda p: (p[0], p[1]))\\n    merged = []\\n    for start, end in pairs:\\n        if merged and start <= merged[-1][1]:\\n            if end > merged[-1][1]:\\n                merged[-1][1] = end\\n        else:\\n            merged.append([start, end])\\n    return merged\\n\"}\n\n{\"action\": \"run\", \"args\": [\"-c\", \"import intervals\\ncases = [\\n    ([[1,3],[3,5]], [[1,5]]),\\n    ([[1,3],[2,6],[8,10],[15,18]], [[1,6],[8,10],[15,18]]),\\n    ([], []),\\n    ([[5,7]], [[5,7]]),\\n    ([[5,5],[5,5]], [[5,5]]),\\n    ([[1,2],[3,4]], [[1,2],[3,4]]),\\n    ([[3,5],[1,3]], [[1,5]]),\\n    ([[10,12],[1,2],[2,10]], [[1,12]]),\\n    ([[1,10],[2,3],[4,5]], [[1,10]]),\\n]\\nfor inp, exp in cases:\\n    snapshot = [list(x) for x in inp]\\n    out = intervals.merge(inp)\\n    assert out == exp, (inp, out, exp)\\n    assert inp == snapshot, ('input modified', inp, snapshot)\\nprint('all tests passed')\\n\"]}\n\n{\"action\": \"finish\"}",
