   "reply": "{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"import re\\n\\n_VERSION_RE = re.compile(\\n    r\\\"^(\\\\d+)\\\\.(\\\\d+)\\\\.(\\\\d+)\\\"\\n    r\\\"(?:-([0-9A-Za-z.-]+))?\\\"\\n    r\\\"(?:\\\\+([0-9A-Za-z.-]+))?$\\\"\\n)\\n\\n\\ndef _parse(version):\\n    m = _VERSION_RE.match(version.strip())\\n    if not m:\\n        raise ValueError(\\\"Invalid semantic version: %r\\\" % (version,))\\n    major, minor, patch, prerelease, _build = m.groups()\\n    major, minor, patch = int(major), int(minor), int(patch)\\n\\n    if prerelease is None:\\n        return (major, minor, patch, 1, ())\\n\\n    identifiers = []\\n    for ident in prerelease.split(\\\".\\\"):\\n        if ident.isdigit():\\n            identifiers.append((0, int(ident)))\\n        else:\\n            identifiers.append((1, ident))\\n    return (major, minor, patch, 0, tuple(identifiers))\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return versions sorted by SemVer 2.0.0 precedence (lowest first).\\n\\n    Build metadata is ignored for ordering. Versions that tie keep their\\n    original input order (stable sort).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_parse)\\n\"}\n\n{\"action\": \"run\", \"args\": [\"-c\", \"from semver import sort_versions as s; print(s(['1.0.0','1.0.0-alpha','1.0.0-alpha.1','1.0.0-alpha.beta','1.0.0-beta','1.0.0-beta.2','1.0.0-beta.11','1.0.0-rc.1','1.0.0+build.5','2.0.0','1.0.0-alpha.1+meta']))\"]}",
