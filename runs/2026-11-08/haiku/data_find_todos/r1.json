   "reply": "\n{\"action\": \"write\", \"path\": \"scan_todos.py\", \"content\": \"import os\\nimport io\\nimport tokenize\\n\\nroot = \\\".\\\"\\nresults = []\\n\\nfor dirpath, dirnames, filenames in os.walk(root):\\n    dirnames[:] = [d for d in dirnames if d != \\\".git\\\"]\\n    for fn in filenames:\\n        if not fn.endswith(\\\".py\\\"):\\n            continue\\n        full = os.path.join(dirpath, fn)\\n        rel = os.path.relpath(full, root).replace(os.sep, \\\"/\\\")\\n        try:\\n            with tokenize.open(full) as f:\\n                src = f.read()\\n        except (OSError, SyntaxError, UnicodeDecodeError):\\n            continue\\n        try:\\n            for tok in tokenize.generate_tokens(io.StringIO(src).readline):\\n                if tok.type == tokenize.COMMENT and \\\"TODO\\\" in tok.string:\\n                    results.append((rel, tok.start[0]))\\n        except (tokenize.TokenError, SyntaxError):\\n            pass\\n\\nresults = sorted(set(results))\\nwith open(\\\"todos.txt\\\", \\\"w\\\", encoding=\\\"utf-8\\\") as out:\\n    for rel, line in results:\\n        out.write(f\\\"{rel}:{line}\\\\n\\\")\\n\\nprint(len(results), \\\"occurrences written\\\")\\n\"}",
