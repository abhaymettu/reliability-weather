   "turn": 1,
   "reply": "\n{\"action\": \"write\", \"path\": \"find_todos.py\", \"content\": \"import os\\nimport sys\\nimport tokenize\\n\\nroot = '.'\\nresults = []\\n\\nfor dp, dns, fns in os.walk(root):\\n    dns[:] = [d for d in dns if d != '.git']\\n    for fn in fns:\\n        if not fn.endswith('.py'):\\n            continue\\n        full = os.path.join(dp, fn)\\n        rel = os.path.relpath(full, root).replace(os.sep, '/')\\n        try:\\n            with tokenize.open(full) as f:\\n                toks = list(tokenize.generate_tokens(f.readline))\\n        except Exception as e:\\n            print('skip', rel, e, file=sys.stderr)\\n            continue\\n        lines = set()\\n        for t in toks:\\n            if t.type == tokenize.COMMENT and 'TODO' in t.string:\\n                lines.add(t.start[0])\\n        for ln in lines:\\n            results.append((rel, ln))\\n\\nresults.sort()\\nwith open('todos.txt', 'w', encoding='utf-8') as f:\\n    for rel, ln in results:\\n        f.write(f'{rel}:{ln}\\\\n')\\nprint(len(results), 'occurrences written')\\n\"}",
