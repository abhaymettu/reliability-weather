   "reply": "{\"action\": \"write\", \"path\": \"test_brackets.py\", \"content\": \"from brackets import balanced\\n\\ncases = [\\n    ('', True),\\n    ('()[]{}', True),\\n    ('([{}])', True),\\n    ('(]', False),\\n    ('([)]', False),\\n    ('((', False),\\n    (')', False),\\n    ('\\\"([\\\"', True),\\n    ('\\\"a\\\\\\\\\\\"(\\\"', False),\\n    ('\\\"a\\\\\\\\\\\"(\\\\\\\\\\\"\\\")', True),\\n    ('\\\"unterminated', False),\\n    ('\\\"abc\\\\\\\\', False),\\n    ('(\\\"()\\\")', True),\\n    ('\\\"\\\\\\\\\\\\\\\\\\\" ()', True),\\n]\\n\\nfailures = 0\\nfor s, expected in cases:\\n    got = balanced(s)\\n    if got != expected:\\n        failures += 1\\n        print('FAIL', repr(s), 'expected', expected, 'got', got)\\n\\nprint('failures:', failures)\\n\"}",
