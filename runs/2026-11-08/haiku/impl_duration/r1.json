   "turn": 1,
   "reply": "\n{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"import re\\n\\n_DURATION_RE = re.compile(\\n    r'\\\\s*'\\n    r'(?:([0-9]+)d)?'\\n    r'(?:([0-9]+)h)?'\\n    r'(?:([0-9]+)m)?'\\n    r'(?:([0-9]+)s)?'\\n    r'\\\\s*'\\n)\\n\\n\\ndef parse_duration(s):\\n    \\\"\\\"\\\"Convert a duration string such as '1h30m' or '1d2h' into seconds.\\n\\n    Units d, h, m, s may each appear at most once, in that order. Each amount\\n    is a non-negative integer. Surrounding whitespace is allowed. Raises\\n    ValueError for anything else, including an empty string or a bare number.\\n    \\\"\\\"\\\"\\n    if not isinstance(s, str):\\n        raise ValueError(f\\\"expected a string, got {type(s).__name__}\\\")\\n\\n    match = _DURATION_RE.fullmatch(s)\\n    if match is None or not any(match.groups()):\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    days, hours, minutes, seconds = (int(g) if g is not None else 0 for g in match.groups())\\n    return days * 86400 + hours * 3600 + minutes * 60 + seconds\\n\"}",
