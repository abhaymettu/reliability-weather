   "turn": 1,
   "reply": "\n<invoke_placeholder>\n{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"import re\\n\\n_PATTERN = re.compile(\\n    r'(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?'\\n)\\n\\n_UNIT_SECONDS = (86400, 3600, 60, 1)\\n\\n\\ndef parse_duration(s):\\n    \\\"\\\"\\\"Convert a duration string such as '1h30m' or '1d2h' into seconds.\\n\\n    Units d, h, m, s may each appear at most once, in that order. Each amount\\n    is a non-negative integer. Surrounding whitespace is ignored. Anything else\\n    raises ValueError.\\n    \\\"\\\"\\\"\\n    if not isinstance(s, str):\\n        raise ValueError(f\\\"duration must be a string, got {type(s).__name__}\\\")\\n\\n    text = s.strip()\\n    match = _PATTERN.fullmatch(text)\\n    if not match or not text:\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    groups = match.groups()\\n    if all(g is None for g in groups):\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    total = 0\\n    for amount, factor in zip(groups, _UNIT_SECONDS):\\n        if amount is not None:\\n            total += int(amount) * factor\\n    return total\\n\"}",
