   "turn": 1,
   "reply": "\n<invoke:write\n{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"import re\\n\\n_PATTERN = re.compile(\\n    r'\\\\s*(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?\\\\s*'\\n)\\n_MULTIPLIERS = (86400, 3600, 60, 1)\\n\\n\\ndef parse_duration(s):\\n    \\\"\\\"\\\"Convert a duration string such as '1h30m' or '1d2h' to seconds.\\n\\n    Units d, h, m, s may each appear at most once, in that order. Each amount\\n    is a non-negative integer. Surrounding whitespace is allowed. Anything else\\n    raises ValueError.\\n    \\\"\\\"\\\"\\n    if not isinstance(s, str):\\n        raise ValueError(f\\\"expected a string, got {type(s).__name__}\\\")\\n\\n    m = _PATTERN.fullmatch(s)\\n    if m is None or all(g is None for g in m.groups()):\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    return sum(\\n        int(g) * mult\\n        for g, mult in zip(m.groups(), _MULTIPLIERS)\\n        if g is not None\\n    )\\n\"}",
