   "turn": 1,
   "reply": "\n{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"import re\\n\\n_PATTERN = re.compile(\\n    r\\\"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?\\\"\\n)\\n_UNIT_SECONDS = (86400, 3600, 60, 1)  # d, h, m, s\\n\\n\\ndef parse_duration(s):\\n    \\\"\\\"\\\"Convert a duration string such as '1h30m' or '1d2h' into seconds.\\n\\n    Units are d, h, m and s, each at most once and in that order. Each amount\\n    is a non-negative integer. Surrounding whitespace is ignored. Anything\\n    else raises ValueError.\\n    \\\"\\\"\\\"\\n    if not isinstance(s, str):\\n        raise ValueError(f\\\"duration must be a string, got {type(s).__name__}\\\")\\n\\n    text = s.strip()\\n    if not text:\\n        raise ValueError(\\\"empty duration\\\")\\n\\n    match = _PATTERN.fullmatch(text)\\n    if match is None:\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    return sum(\\n        int(amount) * unit\\n        for amount, unit in zip(match.groups(), _UNIT_SECONDS)\\n        if amount is not None\\n    )\\n\"}",
