   "reply": "{\"action\": \"write\", \"path\": \"luhn.py\", \"content\": \"\\\"\\\"\\\"Validate card numbers with the Luhn algorithm.\\\"\\\"\\\"\\n\\n\\ndef valid(number):\\n    \\\"\\\"\\\"Return True if the card number passes the Luhn check.\\n\\n    The input is a string. All spaces are removed before checking.\\n    Returns False if fewer than two characters remain or if any\\n    remaining character is not a digit from 0 to 9.\\n    \\\"\\\"\\\"\\n    digits = number.replace(\\\" \\\", \\\"\\\")\\n\\n    if len(digits) < 2:\\n        return False\\n    if not all(\\\"0\\\" <= ch <= \\\"9\\\" for ch in digits):\\n        return False\\n\\n    total = 0\\n    # Walk from the rightmost digit, doubling every second digit.\\n    for position, ch in enumerate(reversed(digits)):\\n        d = int(ch)\\n        if position % 2 == 1:\\n            d *= 2\\n            if d > 9:\\n                d -= 9\\n        total += d\\n\\n    return total % 10 == 0\\n\"}",
