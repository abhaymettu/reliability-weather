   "reply": "\n{\"action\": \"write\", \"path\": \"luhn.py\", \"content\": \"\\\"\\\"\\\"Validate card numbers using the Luhn algorithm.\\\"\\\"\\\"\\n\\n\\ndef valid(number):\\n    \\\"\\\"\\\"Return True if the card number passes the Luhn check, else False.\\n\\n    Spaces are removed before checking. The remaining string must contain\\n    at least two characters, and every character must be an ASCII digit 0-9.\\n    \\\"\\\"\\\"\\n    digits = number.replace(\\\" \\\", \\\"\\\")\\n\\n    if len(digits) < 2:\\n        return False\\n\\n    for ch in digits:\\n        if ch not in \\\"0123456789\\\":\\n            return False\\n\\n    total = 0\\n    for index, ch in enumerate(reversed(digits)):\\n        value = ord(ch) - ord(\\\"0\\\")\\n        if index % 2 == 1:\\n            value *= 2\\n            if value > 9:\\n                value -= 9\\n        total += value\\n\\n    return total % 10 == 0\\n\"}",
