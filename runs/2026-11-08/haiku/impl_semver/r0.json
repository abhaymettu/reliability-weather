   "reply": "{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"def _parse(version):\\n    \\\"\\\"\\\"Return a sort key implementing SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n    # Build metadata is ignored for precedence.\\n    version = version.split('+', 1)[0]\\n    core, _, pre = version.partition('-')\\n    major, minor, patch = (int(part) for part in core.split('.'))\\n\\n    if pre:\\n        # Numeric identifiers sort below alphanumeric ones; numeric compare as int,\\n        # alphanumeric compare by ASCII order.\\n        ids = tuple(\\n            (0, int(ident), '') if (ident.isascii() and ident.isdigit()) else (1, 0, ident)\\n            for ident in pre.split('.')\\n        )\\n        is_release = 0  # pre-release is lower than the same version without one\\n    else:\\n        ids = ()\\n        is_release = 1\\n\\n    return (major, minor, patch, is_release, ids)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the semantic version strings sorted lowest precedence first.\\n\\n    Versions that compare equal keep their input order (sorted() is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_parse)\\n\"}",
