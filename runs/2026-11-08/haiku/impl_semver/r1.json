   "reply": "\n<invoke_file>\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _prerelease_key(identifiers):\\n    \\\"\\\"\\\"Map pre-release identifiers to comparable tuples.\\n\\n    Numeric identifiers compare as integers and sort below alphanumeric ones.\\n    Alphanumeric identifiers compare in ASCII order.\\n    \\\"\\\"\\\"\\n    key = []\\n    for ident in identifiers:\\n        if ident.isdigit():\\n            key.append((0, int(ident), \\\"\\\"))\\n        else:\\n            key.append((1, 0, ident))\\n    return tuple(key)\\n\\n\\ndef _version_key(version):\\n    # Build metadata after '+' is ignored for precedence.\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n\\n    # The pre-release starts at the first '-'.\\n    if \\\"-\\\" in core_and_pre:\\n        core, pre = core_and_pre.split(\\\"-\\\", 1)\\n    else:\\n        core, pre = core_and_pre, None\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    if pre is None:\\n        # A release sorts above any pre-release of the same version.\\n        return (major, minor, patch, 1, ())\\n    return (major, minor, patch, 0, _prerelease_key(pre.split(\\\".\\\")))\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the version strings sorted by SemVer precedence, lowest first.\\n\\n    Versions that compare equal keep their input order (sorted is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_version_key)\\n\"}\n{\"action\": \"run\", \"args\": [\"-c\", \"from semver import sort_versions as s; print(s(['1.0.0','1.0.0-alpha.beta','1.0.0-alpha','1.0.0-alpha.1','1.0.0-rc.1','1.0.0-beta.11','1.0.0-beta.2','1.0.0-beta','0.9.9+b','1.0.0+x','1.0.0+y','1.0.0-2','1.0.0-10']))\"]}\n{\"action\": \"finish\"}",
