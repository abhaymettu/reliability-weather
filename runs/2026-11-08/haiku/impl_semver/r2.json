   "turn": 1,
   "reply": "\n<invoke/write>\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _parse(version):\\n    \\\"\\\"\\\"Split a version string into (core ints, pre-release identifiers).\\n\\n    Build metadata (after '+') is discarded since it does not affect ordering.\\n    \\\"\\\"\\\"\\n    # Drop build metadata.\\n    if \\\"+\\\" in version:\\n        version = version.split(\\\"+\\\", 1)[0]\\n\\n    # Split pre-release (after the first '-').\\n    if \\\"-\\\" in version:\\n        core, pre = version.split(\\\"-\\\", 1)\\n        pre_ids = pre.split(\\\".\\\")\\n    else:\\n        core = version\\n        pre_ids = []\\n\\n    numbers = tuple(int(part) for part in core.split(\\\".\\\"))\\n    return numbers, pre_ids\\n\\n\\ndef _identifier_key(identifier):\\n    \\\"\\\"\\\"Numeric identifiers sort before alphanumeric ones.\\n\\n    Numeric identifiers compare as integers; alphanumeric ones compare in\\n    ASCII order.\\n    \\\"\\\"\\\"\\n    if identifier.isdigit():\\n        return (0, int(identifier), \\\"\\\")\\n    return (1, 0, identifier)\\n\\n\\ndef _sort_key(version):\\n    numbers, pre_ids = _parse(version)\\n    if pre_ids:\\n        # A pre-release sorts below the release with the same core version.\\n        pre_key = (0, tuple(_identifier_key(i) for i in pre_ids))\\n    else:\\n        pre_key = (1, ())\\n    # Tuple comparison makes a shorter identifier list lower when the shared\\n    # prefix is equal, as required by SemVer.\\n    return (numbers, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the version strings in vs sorted lowest precedence first.\\n\\n    Versions that compare equal keep their input order (sort is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_sort_key)\\n\"}",
