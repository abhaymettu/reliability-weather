   "turn": 1,
   "reply": "\n<invoke/write semver.py>\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n_DIGITS = \\\"0123456789\\\"\\n\\n\\ndef _is_numeric(s):\\n    return len(s) > 0 and all(c in _DIGITS for c in s)\\n\\n\\ndef _key(version):\\n    # Build metadata (after '+') is ignored for precedence.\\n    base = version.split(\\\"+\\\", 1)[0]\\n    if \\\"-\\\" in base:\\n        core, pre = base.split(\\\"-\\\", 1)\\n    else:\\n        core, pre = base, None\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    if pre is None:\\n        # A release sorts above any pre-release of the same core version.\\n        return ((major, minor, patch), 1, ())\\n\\n    # Numeric identifiers: (0, int, \\\"\\\") -- lower than any alphanumeric.\\n    # Alphanumeric identifiers: (1, 0, str) -- compared in ASCII order.\\n    # Tuple comparison gives a shorter list lower when the shared prefix ties.\\n    idents = []\\n    for ident in pre.split(\\\".\\\"):\\n        if _is_numeric(ident):\\n            idents.append((0, int(ident), \\\"\\\"))\\n        else:\\n            idents.append((1, 0, ident))\\n    return ((major, minor, patch), 0, tuple(idents))\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the versions sorted lowest precedence first.\\n\\n    Versions with equal precedence keep their input order (sorted is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_key)\\n\"}\n{\"action\": \"write\", \"path\": \"test_semver.py\", \"content\": \"from semver import sort_versions\\n\\nexpected = [\\n    \\\"1.0.0-alpha\\\",\\n    \\\"1.0.0-alpha.1\\\",\\n    \\\"1.0.0-alpha.beta\\\",\\n    \\\"1.0.0-beta\\\",\\n    \\\"1.0.0-beta.2\\\",\\n    \\\"1.0.0-beta.11\\\",\\n    \\\"1.0.0-rc.1\\\",\\n    \\\"1.0.0\\\",\\n    \\\"1.0.1\\\",\\n    \\\"1.1.0\\\",\\n    \\\"2.0.0\\\",\\n]\\n\\nshuffled = list(reversed(expected))\\nresult = sort_versions(shuffled)\\nassert result == expected, result\\n\\n# Build metadata is ignored; ties keep input order.\\nt = [\\\"1.0.0+b\\\", \\\"1.0.0+a\\\", \\\"1.0.0-x+z\\\"]\\nassert sort_versions(t) == [\\\"1.0.0-x+z\\\", \\\"1.0.0+b\\\", \\\"1.0.0+a\\\"], sort_versions(t)\\n\\n# Numeric parts compare as integers.\\nassert sort_versions([\\\"1.10.0\\\", \\\"1.9.0\\\"]) == [\\\"1.9.0\\\", \\\"1.10.0\\\"]\\n\\nprint(\\\"ok\\\")\\n\"}\n{\"action\": \"run\", \"args\": [\"test_semver.py\"]}\n{\"action\": \"finish\"}",
