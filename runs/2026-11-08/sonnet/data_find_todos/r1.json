   "reply": "\n<invoke name=\"write\">\n<parameter name=\"path\">find_todos.py</parameter>\n<parameter name=\"content\">import os, tokenize\n\nkey = \"TO\" + \"DO\"\nres = []\nfor d, dirs, files in os.walk(\".\"):\n    dirs[:] = [x for x in dirs if x != \".git\"]\n    for f in files:\n        if not f.endswith(\".py\"):\n            continue\n        p = os.path.join(d, f)\n        rel = os.path.relpath(p, \".\").replace(os.sep, \"/\")\n        try:\n            with tokenize.open(p) as fh:\n                for t in tokenize.generate_tokens(fh.readline):\n                    if t.type == tokenize.COMMENT and key in t.string:\n                        res.append((rel, t.start[0]))\n        except Exception as e:\n            print(\"error\", rel, e)\nres.sort()\nwith open(\"todos.txt\", \"w\") as o:\n    for r, l in res:\n        o.write(f\"{r}:{l}\\n\")\nprint(res)\n</parameter>\n</invoke>\n\n<parameter name=\"action\">run</parameter>\n<parameter name=\"args\">[\"-I\", \"find_todos.py\"]</parameter>\n\n<parameter name=\"action\">finish</parameter>\n\n<parameter name=\"action\">finish</parameter>",
