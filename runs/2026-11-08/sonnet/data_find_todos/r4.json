   "turn": 1,
   "reply": "\n<invoke name=\"write\">\n<parameter name=\"path\">find_t.py</parameter>\n<parameter name=\"content\">import os, tokenize\nkey = 'TO' + 'DO'\nres = []\nfor d, ds, fs in os.walk('.'):\n    for f in fs:\n        if f.endswith('.py'):\n            p = os.path.join(d, f)\n            rel = os.path.relpath(p, '.').replace(os.sep, '/')\n            try:\n                with open(p, 'rb') as fh:\n                    for t in tokenize.tokenize(fh.readline):\n                        if t.type == tokenize.COMMENT and key in t.string:\n                            res.append((rel, t.start[0]))\n            except Exception as e:\n                print('err', rel, e)\nres = sorted(set(res))\nwith open('todos.txt', 'w') as o:\n    for r, l in res:\n        o.write('%s:%d\\n' % (r, l))\nprint(res)\n</parameter>\n</invoke>\n\n<invoke name=\"run\">\n<parameter name=\"args\">[\"-I\", \"find_t.py\"]</parameter>\n</invoke>\n\n<invoke name=\"finish\">\n</invoke>\n\n<invoke name=\"finish\">\n</invoke>",
