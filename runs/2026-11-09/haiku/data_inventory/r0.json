   "reply": "\n<invoke:\n{\"action\": \"write\", \"path\": \"scripts/process.py\", \"content\": \"import json\\nfrom pathlib import Path\\n\\ninv = {k: int(v) for k, v in json.loads(Path(\\\"inventory.json\\\").read_text(encoding=\\\"utf-8\\\")).items()}\\nlines = Path(\\\"transactions.txt\\\").read_text(encoding=\\\"utf-8\\\").splitlines()\\n\\nrejected = []\\nfor lineno, line in enumerate(lines, 1):\\n    parts = line.split()\\n    if not parts:\\n        continue\\n    if len(parts) != 3:\\n        rejected.append(lineno)\\n        continue\\n    op, sku, q = parts[0].lower(), parts[1], parts[2]\\n    try:\\n        qty = int(q)\\n    except ValueError:\\n        rejected.append(lineno)\\n        continue\\n    if qty < 0:\\n        rejected.append(lineno)\\n        continue\\n    if op == \\\"add\\\":\\n        inv[sku] = inv.get(sku, 0) + qty\\n    elif op == \\\"remove\\\":\\n        if sku not in inv or inv[sku] - qty < 0:\\n            rejected.append(lineno)\\n        else:\\n            inv[sku] -= qty\\n    else:\\n        rejected.append(lineno)\\n\\nPath(\\\"inventory_after.json\\\").write_text(json.dumps(inv, indent=2) + \\\"\\\\n\\\", encoding=\\\"utf-8\\\")\\nPath(\\\"rejected.txt\\\").write_text(\\\"\\\".join(f\\\"{n}\\\\n\\\" for n in rejected), encoding=\\\"utf-8\\\")\\nprint(\\\"rejected:\\\", rejected)\\n\"}",
