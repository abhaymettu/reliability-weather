   "turn": 1,
   "reply": "\n<invoke/script>\n{\"action\": \"write\", \"path\": \"scripts/apply_inventory.py\", \"content\": \"import json\\nimport sys\\n\\n\\ndef parse_qty(text):\\n    try:\\n        qty = int(text)\\n    except ValueError:\\n        return None\\n    return qty if qty >= 0 else None\\n\\n\\ndef main():\\n    inv_path, tx_path, out_path, rej_path = sys.argv[1:5]\\n\\n    with open(inv_path, encoding=\\\"utf-8\\\") as f:\\n        counts = json.load(f)\\n    if not isinstance(counts, dict):\\n        raise SystemExit(\\\"inventory.json must be an object mapping SKU to count\\\")\\n    counts = {str(k): int(v) for k, v in counts.items()}\\n\\n    rejected = []\\n    with open(tx_path, encoding=\\\"utf-8\\\") as f:\\n        lines = f.read().splitlines()\\n\\n    for lineno, raw in enumerate(lines, start=1):\\n        line = raw.strip()\\n        if not line:\\n            continue\\n        parts = line.split()\\n        if len(parts) != 3:\\n            rejected.append(lineno)\\n            continue\\n        op, sku, qty_text = parts\\n        qty = parse_qty(qty_text)\\n        if qty is None:\\n            rejected.append(lineno)\\n            continue\\n        if op == \\\"add\\\":\\n            counts[sku] = counts.get(sku, 0) + qty\\n        elif op == \\\"remove\\\":\\n            if sku not in counts or counts[sku] - qty < 0:\\n                rejected.append(lineno)\\n            else:\\n                counts[sku] -= qty\\n        else:\\n            rejected.append(lineno)\\n\\n    with open(out_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n        json.dump(counts, f, indent=2)\\n        f.write(\\\"\\\\n\\\")\\n    with open(rej_path, \\\"w\\\", encoding=\\\"utf-8\\\") as f:\\n        for n in rejected:\\n            f.write(f\\\"{n}\\\\n\\\")\\n\\n    print(f\\\"skus={len(counts)} rejected={len(rejected)}\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"}",
