   "reply": "\n{\"action\": \"write\", \"path\": \"parse.py\", \"content\": \"def split_csv(line):\\n    fields = []\\n    current = []\\n    in_quotes = False\\n    quoted = False\\n    i = 0\\n    n = len(line)\\n    while i < n:\\n        ch = line[i]\\n        if in_quotes:\\n            if ch == '\\\"':\\n                if i + 1 < n and line[i + 1] == '\\\"':\\n                    current.append('\\\"')\\n                    i += 1\\n                else:\\n                    in_quotes = False\\n            else:\\n                current.append(ch)\\n        else:\\n            if ch == '\\\"' and not current:\\n                in_quotes = True\\n                quoted = True\\n            elif ch == ',':\\n                fields.append(''.join(current))\\n                current = []\\n                quoted = False\\n            else:\\n                current.append(ch)\\n        i += 1\\n    fields.append(''.join(current))\\n    return fields\\n\"}",
