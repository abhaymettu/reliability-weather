   "reply": "\n<invoke/brackets.py\n{\"action\": \"write\", \"path\": \"brackets.py\", \"content\": \"PAIRS = {')': '(', ']': '[', '}': '{'}\\nOPENERS = set(PAIRS.values())\\n\\n\\ndef balanced(s):\\n    \\\"\\\"\\\"Return True if every (, [ and { in s is closed in the right order.\\n\\n    Text inside double-quoted strings is ignored. Inside a string, a backslash\\n    escapes the next character. An unterminated string makes the input unbalanced.\\n    \\\"\\\"\\\"\\n    stack = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        c = s[i]\\n        if c == '\\\"':\\n            # Skip over the string literal.\\n            i += 1\\n            closed = False\\n            while i < n:\\n                d = s[i]\\n                if d == '\\\\\\\\':\\n                    i += 2  # escaped character is consumed\\n                    continue\\n                if d == '\\\"':\\n                    closed = True\\n                    break\\n                i += 1\\n            if not closed:\\n                return False\\n            i += 1  # move past closing quote\\n            continue\\n        if c in OPENERS:\\n            stack.append(c)\\n        elif c in PAIRS:\\n            if not stack or stack[-1] != PAIRS[c]:\\n                return False\\n            stack.pop()\\n        i += 1\\n    return not stack\\n\"}",
