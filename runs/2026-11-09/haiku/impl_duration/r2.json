   "turn": 1,
   "reply": "\n<invoke by 1>\n{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"import re\\n\\n_PATTERN = re.compile(\\n    r\\\"(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?\\\"\\n)\\n_UNIT_SECONDS = (86400, 3600, 60, 1)\\n\\n\\ndef parse_duration(s):\\n    \\\"\\\"\\\"Convert a duration string such as '1h30m' or '1d2h' to seconds.\\n\\n    Units are d, h, m and s. Each unit may appear at most once and must\\n    appear in that order. Each amount is a non-negative integer. Surrounding\\n    whitespace is ignored. Raises ValueError for anything else.\\n    \\\"\\\"\\\"\\n    if not isinstance(s, str):\\n        raise ValueError(f\\\"duration must be a string, not {type(s).__name__}\\\")\\n\\n    text = s.strip()\\n    if not text:\\n        raise ValueError(\\\"empty duration string\\\")\\n\\n    match = _PATTERN.fullmatch(text)\\n    if match is None:\\n        raise ValueError(f\\\"invalid duration: {s!r}\\\")\\n\\n    total = 0\\n    for amount, factor in zip(match.groups(), _UNIT_SECONDS):\\n        if amount is not None:\\n            total += int(amount) * factor\\n    return total\\n\"}",
