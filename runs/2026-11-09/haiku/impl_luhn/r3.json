   "reply": "{\"action\": \"write\", \"path\": \"luhn.py\", \"content\": \"def valid(number):\\n    \\\"\\\"\\\"Return True if the card number passes the Luhn check.\\n\\n    Single spaces between digits are ignored. Returns False if, after\\n    removing spaces, there are fewer than two characters or any character\\n    is not a digit 0-9.\\n    \\\"\\\"\\\"\\n    if not isinstance(number, str):\\n        return False\\n\\n    digits = number.replace(\\\" \\\", \\\"\\\")\\n\\n    if len(digits) < 2:\\n        return False\\n\\n    if not all(\\\"0\\\" <= ch <= \\\"9\\\" for ch in digits):\\n        return False\\n\\n    total = 0\\n    for index, ch in enumerate(reversed(digits)):\\n        d = ord(ch) - ord(\\\"0\\\")\\n        if index % 2 == 1:\\n            d *= 2\\n            if d > 9:\\n                d -= 9\\n        total += d\\n\\n    return total % 10 == 0\\n\"}",
