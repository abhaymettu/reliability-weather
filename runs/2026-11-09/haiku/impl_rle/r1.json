   "turn": 1,
   "reply": "\n<invoke.write\n{\"action\": \"write\", \"path\": \"rle.py\", \"content\": \"\\\"\\\"\\\"Run-length encoding for strings of letters.\\n\\nA run of the same character is written as the character followed by its\\nlength, with the length omitted when it is 1. For example,\\nencode('aaabcc') == 'a3bc2'.\\n\\\"\\\"\\\"\\n\\n\\ndef encode(s):\\n    \\\"\\\"\\\"Encode runs of repeated characters as char + count (count omitted if 1).\\\"\\\"\\\"\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        ch = s[i]\\n        j = i\\n        while j < n and s[j] == ch:\\n            j += 1\\n        count = j - i\\n        out.append(ch)\\n        if count > 1:\\n            out.append(str(count))\\n        i = j\\n    return ''.join(out)\\n\\n\\ndef decode(s):\\n    \\\"\\\"\\\"Inverse of encode: a letter optionally followed by a multi-digit count.\\\"\\\"\\\"\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        ch = s[i]\\n        i += 1\\n        j = i\\n        while j < n and s[j].isdigit():\\n            j += 1\\n        count = int(s[i:j]) if j > i else 1\\n        out.append(ch * count)\\n        i = j\\n    return ''.join(out)\\n\"}",
