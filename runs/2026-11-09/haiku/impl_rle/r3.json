   "turn": 1,
   "reply": "\n{\"action\": \"write\", \"path\": \"rle.py\", \"content\": \"import re\\n\\n\\ndef encode(s):\\n    \\\"\\\"\\\"Run-length encode s: each run becomes its character, followed by the\\n    run length when the length is greater than 1.\\n\\n    encode('aaabcc') == 'a3bc2'\\n    \\\"\\\"\\\"\\n    out = []\\n    i = 0\\n    while i < len(s):\\n        j = i\\n        while j < len(s) and s[j] == s[i]:\\n            j += 1\\n        n = j - i\\n        out.append(s[i])\\n        if n > 1:\\n            out.append(str(n))\\n        i = j\\n    return ''.join(out)\\n\\n\\ndef decode(s):\\n    \\\"\\\"\\\"Inverse of encode. Run lengths may have multiple digits.\\n\\n    decode('a3bc2') == 'aaabcc'\\n    \\\"\\\"\\\"\\n    parts = []\\n    for char, count in re.findall(r'([A-Za-z])(\\\\d*)', s):\\n        parts.append(char * int(count) if count else char)\\n    return ''.join(parts)\\n\"}",
