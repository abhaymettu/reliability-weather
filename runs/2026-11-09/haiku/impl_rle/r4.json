   "reply": "\n<jsonaction>\n{\"action\": \"write\", \"path\": \"rle.py\", \"content\": \"import re\\n\\n\\ndef encode(s):\\n    \\\"\\\"\\\"Run-length encode s. Each run becomes its character followed by the\\n    run length, omitted when the length is 1. Input is letters only.\\\"\\\"\\\"\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        ch = s[i]\\n        j = i\\n        while j < n and s[j] == ch:\\n            j += 1\\n        count = j - i\\n        out.append(ch)\\n        if count > 1:\\n            out.append(str(count))\\n        i = j\\n    return ''.join(out)\\n\\n\\n_TOKEN = re.compile(r'([A-Za-z])(\\\\d*)')\\n\\n\\ndef decode(s):\\n    \\\"\\\"\\\"Inverse of encode. Handles run lengths with multiple digits.\\\"\\\"\\\"\\n    out = []\\n    for ch, digits in _TOKEN.findall(s):\\n        count = int(digits) if digits else 1\\n        out.append(ch * count)\\n    return ''.join(out)\\n\"}\n</accepted>\n\n\n<jsonaction>\n{\"action\": \"finish\"}\n</accepted>",
