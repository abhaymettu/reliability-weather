   "reply": "\n<types>\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n_DIGITS = \\\"0123456789\\\"\\n\\n\\ndef _is_numeric(ident):\\n    return ident != \\\"\\\" and all(ch in _DIGITS for ch in ident)\\n\\n\\ndef _precedence_key(version):\\n    # Build metadata (after '+') is ignored for ordering.\\n    without_build = version.split(\\\"+\\\", 1)[0]\\n\\n    # The core never contains a hyphen, so split on the first one only.\\n    if \\\"-\\\" in without_build:\\n        core, pre = without_build.split(\\\"-\\\", 1)\\n    else:\\n        core, pre = without_build, None\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    if pre is None:\\n        # A release version sorts above any pre-release of the same core.\\n        pre_key = (1,)\\n    else:\\n        identifiers = []\\n        for ident in pre.split(\\\".\\\"):\\n            if _is_numeric(ident):\\n                # Numeric identifiers sort below alphanumeric ones.\\n                identifiers.append((0, int(ident), \\\"\\\"))\\n            else:\\n                identifiers.append((1, 0, ident))\\n        # Tuple comparison makes a shorter list lower when its prefix matches.\\n        pre_key = (0, tuple(identifiers))\\n\\n    return (major, minor, patch, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the version strings in vs sorted lowest precedence first.\\n\\n    Versions that compare equal keep their input order (sorted is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_precedence_key)\\n\"}",
