   "reply": "{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"def _parse(version):\\n    \\\"\\\"\\\"Return (major, minor, patch, prerelease_identifiers) for a SemVer string.\\n\\n    Build metadata (after '+') is discarded.\\n    \\\"\\\"\\\"\\n    core = version.split('+', 1)[0]\\n    if '-' in core:\\n        core, pre = core.split('-', 1)\\n        identifiers = pre.split('.')\\n    else:\\n        identifiers = None\\n    major, minor, patch = (int(part) for part in core.split('.'))\\n    return major, minor, patch, identifiers\\n\\n\\ndef _identifier_key(identifier):\\n    # Numeric identifiers sort below alphanumeric ones; numeric compare as ints,\\n    # alphanumeric compare by ASCII order.\\n    if identifier.isdigit():\\n        return (0, int(identifier), '')\\n    return (1, 0, identifier)\\n\\n\\ndef _precedence_key(version):\\n    major, minor, patch, identifiers = _parse(version)\\n    if identifiers is None:\\n        # A release version ranks above any pre-release of the same core.\\n        return (major, minor, patch, 1, ())\\n    return (\\n        major,\\n        minor,\\n        patch,\\n        0,\\n        tuple(_identifier_key(i) for i in identifiers),\\n    )\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the semantic version strings in vs sorted by SemVer 2.0.0 precedence.\\n\\n    Lowest precedence first. Versions that compare equal keep their input order\\n    (Python's sort is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_precedence_key)\\n\"}",
