   "turn": 1,
   "reply": "\n<invoke_placeholder\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _parse(version):\\n    \\\"\\\"\\\"Return a sort key for a SemVer string.\\n\\n    Build metadata (after '+') is discarded. A version without a pre-release\\n    gets a flag that ranks it above any pre-release of the same core version.\\n    \\\"\\\"\\\"\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n\\n    if \\\"-\\\" in core_and_pre:\\n        core, pre = core_and_pre.split(\\\"-\\\", 1)\\n    else:\\n        core, pre = core_and_pre, None\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    if pre is None:\\n        # Release versions rank above pre-releases of the same core.\\n        return (major, minor, patch, 1, ())\\n\\n    identifiers = []\\n    for ident in pre.split(\\\".\\\"):\\n        if ident.isdigit():\\n            # Numeric identifiers: compare as integers, lower than alphanumeric.\\n            identifiers.append((0, int(ident), \\\"\\\"))\\n        else:\\n            # Alphanumeric identifiers: compare in ASCII order.\\n            identifiers.append((1, 0, ident))\\n\\n    # A shorter list is lower when all shared identifiers are equal; tuple\\n    # comparison already gives that behaviour.\\n    return (major, minor, patch, 0, tuple(identifiers))\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the versions in SemVer precedence order, lowest first.\\n\\n    Versions that compare equal (differing only in build metadata) keep\\n    their input order, since Python's sort is stable.\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_parse)\\n\"}",
