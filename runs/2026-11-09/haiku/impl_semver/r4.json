   "turn": 1,
   "reply": "\n<invoke.semver.write\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _key(version):\\n    # Build metadata (after '+') is ignored for precedence.\\n    core_and_pre = version.split('+', 1)[0]\\n    if '-' in core_and_pre:\\n        core, pre = core_and_pre.split('-', 1)\\n    else:\\n        core, pre = core_and_pre, None\\n\\n    major, minor, patch = (int(part) for part in core.split('.'))\\n\\n    if pre is None:\\n        # A release sorts above any pre-release of the same version.\\n        pre_key = (1, ())\\n    else:\\n        idents = []\\n        for ident in pre.split('.'):\\n            if ident.isdigit():\\n                # Numeric identifiers compare as integers and sort below alphanumeric ones.\\n                idents.append((0, int(ident), ''))\\n            else:\\n                # Alphanumeric identifiers compare in ASCII order.\\n                idents.append((1, 0, ident))\\n        # Tuple comparison makes a shorter list lower when the shared prefix is equal.\\n        pre_key = (0, tuple(idents))\\n\\n    return (major, minor, patch, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the version strings in vs sorted lowest precedence first.\\n\\n    Versions that compare equal keep their input order (sorted is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_key)\\n\\n\\nif __name__ == '__main__':\\n    sample = [\\n        '1.0.0',\\n        '1.0.0-rc.1',\\n        '1.0.0-beta.11',\\n        '1.0.0-beta.2',\\n        '1.0.0-beta',\\n        '1.0.0-alpha',\\n        '1.0.0-alpha.1',\\n        '1.0.0-alpha.beta',\\n        '0.9.9',\\n        '2.0.0+build.5',\\n        '1.0.0+build.9',\\n        '10.0.0',\\n        '1.10.0',\\n        '1.2.0',\\n    ]\\n    for v in sort_versions(sample):\\n        print(v)\\n\"}",
