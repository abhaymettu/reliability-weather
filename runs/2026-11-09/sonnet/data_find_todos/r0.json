   "reply": "\n<invoke name=\"write\">\n<parameter name=\"path\">find_markers.py</parameter>\n<parameter name=\"content\">import os, tokenize\n\nroot = \".\"\nword = \"TO\" + \"DO\"\nres = []\nfor d, dirs, files in os.walk(root):\n    dirs[:] = [x for x in dirs if x != \".git\"]\n    for f in files:\n        if not f.endswith(\".py\"):\n            continue\n        p = os.path.join(d, f)\n        rel = os.path.relpath(p, root).replace(os.sep, \"/\")\n        if rel == \"find_markers.py\":\n            continue\n        try:\n            with tokenize.open(p) as fh:\n                for t in tokenize.generate_tokens(fh.readline):\n                    if t.type == tokenize.COMMENT and word in t.string:\n                        res.append((rel, t.start[0]))\n        except Exception as e:\n            print(\"ERR\", rel, e)\nres.sort()\nwith open(\"todos.txt\", \"w\") as o:\n    for r, l in res:\n        o.write(f\"{r}:{l}\\n\")\nprint(res)\n</parameter>\n</invoke>\nora\n\n\n<invoke name=\"run\">\n<parameter name=\"args\">[\"find_markers.py\"]</parameter>\n</invoke>\nora\n\n\n<invoke name=\"finish\">\n</invoke>\nora",
