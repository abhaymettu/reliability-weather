   "reply": "\n<invoke name=\"write\">\n<parameter name=\"path\">conv.py</parameter>\n<parameter name=\"content\">import csv\n\nwith open(\"table.csv\", newline=\"\") as f:\n    rows = list(csv.reader(f))\nheader, body = rows[0], rows[1:]\nn = len(header)\n\n\ndef isnum(v):\n    try:\n        float(v)\n        return True\n    except ValueError:\n        return False\n\n\ndef esc(s):\n    return s.replace(\"|\", \"\\\\|\")\n\n\nnumeric = [all(isnum(r[i]) for r in body) for i in range(n)]\nH = [esc(c) for c in header]\nB = [[esc(c) for c in r] for r in body]\nw = [max(3, len(H[i]), *(len(r[i]) for r in B)) for i in range(n)]\n\n\ndef fmt(cells):\n    out = []\n    for i, c in enumerate(cells):\n        out.append(c.rjust(w[i]) if numeric[i] else c.ljust(w[i]))\n    return \"| \" + \" | \".join(out) + \" |\"\n\n\nlines = [fmt(H)]\nlines.append(\"| \" + \" | \".join(\n    (\"-\" * (w[i] - 1) + \":\") if numeric[i] else \"-\" * w[i] for i in range(n)) + \" |\")\nlines += [fmt(r) for r in B]\nwith open(\"table.md\", \"w\") as f:\n    f.write(\"\\n\".join(lines) + \"\\n\")\n</parameter>\n</invoke>\n\n{\"action\": \"run\", \"args\": [\"-I\", \"conv.py\"]}",
