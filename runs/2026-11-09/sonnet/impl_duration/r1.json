   "reply": "{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"import re\\n\\n_PATTERN = re.compile(r'(?:([0-9]+)d)?(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?')\\n_MULT = (86400, 3600, 60, 1)\\n\\n\\ndef parse_duration(s):\\n    if not isinstance(s, str):\\n        raise ValueError('duration must be a string')\\n    s = s.strip()\\n    if not s:\\n        raise ValueError('empty duration')\\n    m = _PATTERN.fullmatch(s)\\n    if not m:\\n        raise ValueError('invalid duration: %r' % s)\\n    return sum(int(g) * k for g, k in zip(m.groups(), _MULT) if g is not None)\\n\"}",
