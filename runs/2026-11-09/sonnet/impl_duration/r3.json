   "reply": "{\"action\": \"write\", \"path\": \"duration.py\", \"content\": \"import re\\n\\n_PATTERN = re.compile(r'(?:(\\\\d+)d)?(?:(\\\\d+)h)?(?:(\\\\d+)m)?(?:(\\\\d+)s)?', re.ASCII)\\n\\n\\ndef parse_duration(s):\\n    if not isinstance(s, str):\\n        raise ValueError('duration must be a string')\\n    s = s.strip()\\n    m = _PATTERN.fullmatch(s)\\n    if not s or m is None:\\n        raise ValueError('invalid duration: %r' % s)\\n    d, h, mi, sec = (int(g) if g else 0 for g in m.groups())\\n    return ((d * 24 + h) * 60 + mi) * 60 + sec\\n\"}",
