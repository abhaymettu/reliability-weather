   "reply": "\n\n{\"action\": \"write\", \"path\": \"parse.py\", \"content\": \"def split_csv(line):\\n    \\\"\\\"\\\"Split one CSV line into fields.\\n\\n    Fields may be wrapped in double quotes. Inside a quoted field a comma is\\n    literal and a doubled quote (\\\"\\\") represents a single quote character.\\n    The surrounding quotes are not part of the field value.\\n    \\\"\\\"\\\"\\n    fields = []\\n    cur = []\\n    in_quotes = False\\n    i = 0\\n    n = len(line)\\n\\n    while i < n:\\n        c = line[i]\\n        if in_quotes:\\n            if c == '\\\"':\\n                if i + 1 < n and line[i + 1] == '\\\"':\\n                    cur.append('\\\"')\\n                    i += 2\\n                else:\\n                    in_quotes = False\\n                    i += 1\\n            else:\\n                cur.append(c)\\n                i += 1\\n        else:\\n            if c == '\\\"':\\n                in_quotes = True\\n                i += 1\\n            elif c == ',':\\n                fields.append(''.join(cur))\\n                cur = []\\n                i += 1\\n            else:\\n                cur.append(c)\\n                i += 1\\n\\n    fields.append(''.join(cur))\\n    return fields\\n\"}\n\nThen test quickly with run.\n\n{\"action\": \"run\", \"args\": [\"-c\", \"from parse import split_csv\\nprint(split_csv('a,b,c'))\\nprint(split_csv('\\\"a,b\\\",c'))\\nprint(split_csv('\\\"a\\\"\\\"b\\\",c'))\\nprint(split_csv('\\\"\\\",x,\\\"y\\\"\\\"z\\\"'))\\nprint(split_csv('a,,\\\"b,c\\\"'))\\nprint(split_csv('\\\"multi\\\\nline\\\",z'))\\nprint(split_csv(''))\"]}",
