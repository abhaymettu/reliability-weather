   "reply": "{\"action\": \"write\", \"path\": \"gen.py\", \"content\": \"import csv\\nimport io\\n\\ndef parse_number(s):\\n    try:\\n        float(s)\\n        return True\\n    except (ValueError, TypeError):\\n        return False\\n\\nwith open('table.csv', newline='') as f:\\n    rows = list(csv.reader(f))\\n\\n# Filter out fully empty rows (blank lines)\\nrows = [r for r in rows if r and any(v.strip() != '' for v in r)]\\n\\nheader = rows[0]\\ndata = rows[1:]\\n\\nncols = len(header)\\n\\n# Escape pipes\\nheader_esc = [h.replace('|', '\\\\\\\\|') for h in header]\\ndata_esc = [[cell.replace('|', '\\\\\\\\|') for cell in row] for row in data]\\n\\n# Determine numeric columns\\nnumeric = []\\nfor c in range(ncols):\\n    col_vals = [row[c] for row in data]\\n    numeric.append(all(parse_number(v) for v in col_vals) and len(col_vals) > 0)\\n\\n# Compute widths\\nwidths = []\\nfor c in range(ncols):\\n    w = len(header_esc[c])\\n    for row in data_esc:\\n        w = max(w, len(row[c]))\\n    w = max(w, 3)\\n    widths.append(w)\\n\\nlines = []\\n# Header row\\ndef format_cell(text, width, is_numeric):\\n    if is_numeric:\\n        return text.rjust(width)\\n    else:\\n        return text.ljust(width)\\n\\nformatted_header = [format_cell(header_esc[c], widths[c], numeric[c]) for c in range(ncols)]\\nlines.append('| ' + ' | '.join(formatted_header) + ' |')\\n\\n# Separator\\nsep_cells = []\\nfor c in range(ncols):\\n    w = widths[c]\\n    if numeric[c]:\\n        sep_cells.append('-' * (w - 1) + ':')\\n    else:\\n        sep_cells.append('-' * w)\\nlines.append('| ' + ' | '.join(sep_cells) + ' |')\\n\\n# Data rows\\nfor row in data_esc:\\n    formatted = [format_cell(row[c], widths[c], numeric[c]) for c in range(ncols)]\\n    lines.append('| ' + ' | '.join(formatted) + ' |')\\n\\nout = '\\\\n'.join(lines) + '\\\\n'\\nwith open('table.md', 'w', newline='') as f:\\n    f.write(out)\\n\"}",
