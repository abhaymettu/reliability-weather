   "reply": "\n{\"action\": \"write\", \"path\": \"convert_table.py\", \"content\": \"import csv\\n\\nwith open('table.csv', newline='') as f:\\n    rows = list(csv.reader(f))\\nheader = rows[0]\\nbody = rows[1:]\\n\\ndef isnum(x):\\n    try:\\n        float(x)\\n        return True\\n    except ValueError:\\n        return False\\n\\nnum = [all(isnum(r[i]) for r in body) for i in range(len(header))]\\n\\ndef esc(s):\\n    return s.replace('|', chr(92) + '|')\\n\\ncells = [[esc(c) for c in r] for r in [header] + body]\\nwidths = [max(3, max(len(r[i]) for r in cells)) for i in range(len(header))]\\n\\ndef fmt(r):\\n    parts = []\\n    for i, (c, w) in enumerate(zip(r, widths)):\\n        parts.append(c.rjust(w) if num[i] else c.ljust(w))\\n    return '| ' + ' | '.join(parts) + ' |'\\n\\nseps = []\\nfor i, w in enumerate(widths):\\n    seps.append('-' * (w - 1) + ':' if num[i] else '-' * w)\\nsep_line = '| ' + ' | '.join(seps) + ' |'\\n\\nlines = [fmt(cells[0]), sep_line] + [fmt(r) for r in cells[1:]]\\nwith open('table.md', 'w') as f:\\n    f.write(chr(10).join(lines) + chr(10))\\n\"}",
