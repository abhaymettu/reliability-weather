   "turn": 1,
   "reply": "{\"action\": \"write\", \"path\": \"rle.py\", \"content\": \"\\\"\\\"\\\"Run-length encoding for strings of letters.\\n\\nA run of the same character is written as the character followed by its\\nlength, with the length omitted when it is 1:\\n\\n    encode('aaabcc') == 'a3bc2'\\n\\nSince the input to encode contains only letters, every digit in an encoded\\nstring belongs to a run length, so decode is an exact inverse.\\n\\\"\\\"\\\"\\n\\n\\ndef encode(s):\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        ch = s[i]\\n        j = i\\n        while j < n and s[j] == ch:\\n            j += 1\\n        count = j - i\\n        out.append(ch)\\n        if count > 1:\\n            out.append(str(count))\\n        i = j\\n    return ''.join(out)\\n\\n\\ndef decode(s):\\n    out = []\\n    i = 0\\n    n = len(s)\\n    while i < n:\\n        ch = s[i]\\n        if ch.isdigit():\\n            raise ValueError(f\\\"invalid encoded string: digit at position {i} has no preceding character\\\")\\n        i += 1\\n        start = i\\n        while i < n and s[i].isdigit():\\n            i += 1\\n        count = int(s[start:i]) if i > start else 1\\n        out.append(ch * count)\\n    return ''.join(out)\\n\\n\\nif __name__ == '__main__':\\n    assert encode('aaabcc') == 'a3bc2'\\n    assert encode('') == ''\\n    assert encode('a') == 'a'\\n    assert encode('aaaaaaaaaaaa') == 'a12'\\n    assert decode('a3bc2') == 'aaabcc'\\n    assert decode('a12') == 'a' * 12\\n    assert decode('') == ''\\n    for sample in ['', 'a', 'abc', 'aabbbcccc', 'z' * 37 + 'y', 'AAbbCC']:\\n        assert decode(encode(sample)) == sample\\n    print('all tests passed')\\n\"}",
