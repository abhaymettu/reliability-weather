   "turn": 1,
   "reply": "\n{\"action\": \"write\", \"path\": \"semver.py\", \"content\": \"\\\"\\\"\\\"Sort semantic version strings by SemVer 2.0.0 precedence.\\\"\\\"\\\"\\n\\n\\ndef _parse(version):\\n    \\\"\\\"\\\"Return a sort key for a SemVer string. Build metadata is ignored.\\\"\\\"\\\"\\n    # Build metadata (after '+') does not affect precedence.\\n    core_and_pre = version.split(\\\"+\\\", 1)[0]\\n\\n    # The core never contains a hyphen, so the first hyphen starts the\\n    # pre-release. The pre-release itself may contain hyphens.\\n    core, _, pre = core_and_pre.partition(\\\"-\\\")\\n\\n    major, minor, patch = (int(part) for part in core.split(\\\".\\\"))\\n\\n    if pre:\\n        # Numeric identifiers sort below alphanumeric ones, and numeric ones\\n        # compare as integers. Alphanumeric ones compare in ASCII order.\\n        ids = tuple(\\n            (0, int(ident)) if ident.isdigit() else (1, ident)\\n            for ident in pre.split(\\\".\\\")\\n        )\\n        pre_key = (0, ids)\\n    else:\\n        # A release has higher precedence than any pre-release of the same version.\\n        pre_key = (1, ())\\n\\n    return (major, minor, patch, pre_key)\\n\\n\\ndef sort_versions(vs):\\n    \\\"\\\"\\\"Return the versions sorted by SemVer precedence, lowest first.\\n\\n    Versions that compare equal keep their input order (sorted is stable).\\n    \\\"\\\"\\\"\\n    return sorted(vs, key=_parse)\\n\"}",
