<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.abhay.reliability-weather</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>-f</string><string>__REPO__/scripts/daily.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/reliability-weather.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/reliability-weather.log</string>
  <key>Nice</key><integer>10</integer>
</dict>
</plist>
